<!-- 04 · WHAT I BUILD -->
<section class="rec" id="work" data-title="Work Mode" data-fx="rot" aria-labelledby="t-work">
  <div class="wrap">
    <header class="rh rv"><span class="rn" aria-hidden="true">04</span><div><h2 class="rt" id="t-work" data-split>What I build</h2><p class="rsub">My areas of work.</p></div></header>
    <div class="fan rv" id="fan">
      <article class="fp on" tabindex="0"><span class="fn">A</span><i class="fa-solid fa-globe"></i><h3>Responsive Websites</h3><p>Clean and responsive web interfaces designed to work across different screen sizes and devices.</p><span class="fs">HTML · CSS · JavaScript</span></article>
      <article class="fp" tabindex="0"><span class="fn">B</span><i class="fa-solid fa-server"></i><h3>Web-Based Systems</h3><p>Practical systems for organizing information, managing processes, and supporting everyday operations.</p><span class="fs">PHP · CRUD · Systems</span></article>
      <article class="fp" tabindex="0"><span class="fn">C</span><i class="fa-solid fa-database"></i><h3>Database Applications</h3><p>Database-driven applications that organize, store, retrieve, and manage application information.</p><span class="fs">MySQL · PHP · CRUD</span></article>
      <article class="fp" tabindex="0"><span class="fn">D</span><i class="fa-solid fa-gears"></i><h3>Practical Systems</h3><p>Information, POS, inventory, and reservation systems developed as hands-on learning projects.</p><span class="fs">Systems · Databases · UI</span></article>
    </div>

    <div class="proc rv" id="proc">
      <div class="proc-h"><h3 class="sub2">How I work</h3><p class="rsub">A simple, clear process so every project stays on track and easy to follow.</p></div>
      <div class="proc-steps" role="tablist" aria-label="Process steps">
        <button class="on" role="tab" aria-selected="true" data-s="0"><b>1</b>Understand</button><button role="tab" aria-selected="false" data-s="1"><b>2</b>Plan &amp; design</button><button role="tab" aria-selected="false" data-s="2"><b>3</b>Build</button><button role="tab" aria-selected="false" data-s="3"><b>4</b>Test &amp; refine</button><button role="tab" aria-selected="false" data-s="4"><b>5</b>Deliver</button>
      </div>
