let pi=0,pf='all',ph=null,presI=0,ps='',cmpOn=false,cmpSel=[];const pq=$('#pq');
const vis=()=>P.map((p,i)=>i).filter(i=>(pf==='all'||P[i].f===pf)&&(!ps||matches([P[i].t,P[i].cat,P[i].tag,P[i].d,P[i].tech.join(' ')].join(' '),ps)));
const viewHTML=(p,i)=>p.shots?`<div class="v vs v${p.v}" style="--c1:${p.c1};--c2:${p.c2}"><div class="art"></div><div class="shots">${p.shots.map((s,k)=>`<img src="${s}" alt="${esc(p.t)} — ${esc(p.caps[k])}" loading="lazy" width="1400" data-k="${k}">`).join('')}</div><span class="cap">Screenshots · ${esc(p.t.split(' — ')[0].split(' Ticketing')[0])}</span></div>`:`<div class="v v${p.v}" style="--c1:${p.c1};--c2:${p.c2}"><div class="art"></div><div class="bar3"></div>${DECO[p.v]}<i class="big-i fa-solid ${p.ic}"></i><b class="big-n">${pad(i+1)}</b><span class="cap">Screenshots coming soon</span></div>`;
const kstHTML=p=>p.kst?`<div class="kst">${p.kst.map(k=>`<div><b>${k[0]}</b>${k[1]}</div>`).join('')}</div>`:'';
$('#fl').innerHTML=FILT.map((f,i)=>`<button type="button" data-f="${f[0]}" class="${i?'':'on'}" aria-pressed="${!i}">${f[1]}</button>`).join('');
function drawList(){const v=vis();$('#pxList').innerHTML=P.map((p,i)=>`<li data-i="${i}" class="${i===pi?'on':''} ${v.includes(i)?'':'gone'} ${ph&&p.tech.includes(ph)?'hit':''} ${cmpSel.includes(i)?'picked':''}"><button type="button" aria-current="${i===pi}"><span class="n">${pad(i+1)}</span><h3>${esc(p.t)}</h3><small>${esc(p.cat)}</small></button><button type="button" class="pick" data-pick="${i}" aria-pressed="${cmpSel.includes(i)}" aria-label="${cmpSel.includes(i)?'Remove':'Add'} ${esc(p.t)} ${cmpSel.includes(i)?'from':'to'} comparison"><i class="fa-solid ${cmpSel.includes(i)?'fa-check':'fa-plus'}"></i></button></li>`).join('');
  $('#pxEmpty').hidden=v.length>0;const pos=v.indexOf(pi);$('#pxCnt').textContent=v.length?pad(pos+1)+' / '+pad(v.length):'00 / 00'}
function showP(i){if(i===undefined)return;pi=i;const p=P[i];drawList();const st=$('#pxStage');st.innerHTML=viewHTML(p,i);st.setAttribute('role','button');st.setAttribute('tabindex','0');st.setAttribute('aria-label','Open presentation: '+p.t);
  $('#pxInfo').innerHTML=`<span class="tag">${esc(p.tag)}</span><h3>${esc(p.t)}</h3><p>${esc(p.d)}</p>${kstHTML(p)}<div class="tech" aria-label="Technologies — select one to see other projects that use it">${p.tech.map(t=>`<button type="button" data-t="${esc(t)}" class="${t===ph?'on':''}" aria-pressed="${t===ph}">${esc(t)}</button>`).join('')}</div><div class="px-act"><button class="btn" type="button" data-open="${i}" data-mag><i class="fa-solid fa-expand"></i> Open presentation</button>${p.link?`<a class="btn btn-o" href="${p.link[0]}" target="_blank" rel="noopener" data-mag><i class="fa-solid ${p.link[2]}"></i> ${p.link[1]}</a>`:''}<span class="px-m"><i class="fa-solid fa-layer-group"></i> ${esc(p.cat)}</span></div>`}
$('#pxList').onclick=e=>{const k=e.target.closest('[data-pick]');if(k){const i=+k.dataset.pick;if(cmpSel.includes(i))cmpSel=cmpSel.filter(x=>x!==i);else if(cmpSel.length>=3){toast('You can compare up to 3 projects at a time.');return}else cmpSel.push(i);cmpUpd();drawList();const nb=$(`#pxList [data-pick="${i}"]`);nb&&nb.focus();return}const l=e.target.closest('li');if(l){showP(+l.dataset.i);beep(700,.05,.02,'square')}};
$('#fl').onclick=e=>{const b=e.target.closest('button');if(!b)return;pf=b.dataset.f;$$('#fl button').forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)});const v=vis();showP(v.includes(pi)?pi:v[0]);if(!v.length)drawList()};
pq.oninput=()=>{ps=pq.value.trim();const v=vis();if(v.length)showP(v.includes(pi)?pi:v[0]);else drawList()};
const stepPx=d=>{const v=vis();if(!v.length)return;const n=v[(Math.max(0,v.indexOf(pi))+d+v.length)%v.length];showP(n)};
$('#pxPrev').onclick=()=>stepPx(-1);$('#pxNext').onclick=()=>stepPx(1);
$('#pxInfo').onclick=e=>{const t=e.target.closest('.tech button');if(t){ph=ph===t.dataset.t?null:t.dataset.t;$$('.tech button').forEach(x=>{x.classList.toggle('on',x.dataset.t===ph);x.setAttribute('aria-pressed',x.dataset.t===ph)});drawList();toast(ph?'Also uses '+ph+': '+P.filter(p=>p.tech.includes(ph)).length+' project(s) marked':'Technology filter cleared');return}const o=e.target.closest('[data-open]');if(o)openPres(+o.dataset.open,e)};
$('#pxStage').onclick=e=>openPres(pi,e);$('#pxStage').onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openPres(pi,e)}};
showP(0);
/* compare */
function cmpUpd(){$('#cmpN').textContent=cmpSel.length?cmpSel.length+' selected'+(cmpSel.length<2?' — pick at least one more':''):'Pick 2 or 3 projects';$('#cmpGo').disabled=cmpSel.length<2}
$('#cmpT').onclick=()=>{cmpOn=!cmpOn;$('#cmpT').setAttribute('aria-pressed',cmpOn);$('#pxList').classList.toggle('cmp-on',cmpOn);$('#cmpBar').hidden=!cmpOn;if(!cmpOn)cmpSel=[];cmpUpd();drawList();if(cmpOn)toast('Compare mode: use the + buttons to pick up to 3 projects.')};
$('#cmpClr').onclick=()=>{cmpSel=[];cmpUpd();drawList()};
$('#cmpGo').onclick=()=>{if(cmpSel.length<2)return;const L=cmpSel.map(i=>P[i]);
  const rows=[['Category',p=>esc(p.cat)],['Project type',p=>esc(p.tag)],['Group',p=>esc(FL[p.f])],['Technologies',p=>p.tech.map(esc).join(', ')],['Key numbers',p=>p.kst?p.kst.map(k=>esc(k[0]+' '+k[1].toLowerCase())).join(', '):'Not listed'],['Screenshots',p=>p.shots?p.shots.length+' available':'Screenshots coming soon'],['Live link',p=>p.link?`<a href="${p.link[0]}" target="_blank" rel="noopener">${esc(p.link[1])}</a>`:'No live link listed'],['Description',p=>esc(p.d)]];
  const t=$('#cmpT2');t.style.setProperty('--n',L.length);
  t.innerHTML='<div class="corner fr"></div>'+L.map(p=>`<div class="hd fr">${esc(p.t)}</div>`).join('')+rows.map(r=>`<div class="k">${r[0]}</div>`+L.map(p=>`<div>${r[1](p)}</div>`).join('')).join('');CMP.show($('#cmpGo'))};
/* presentation */
const pres=$('#pres');let presT,presFocus;
function drawPres(i){presI=i;const p=P[i];$('#presIn').innerHTML=`<div class="pres-top"><span class="lbl">Project ${pad(i+1)} of ${pad(P.length)}</span><div class="cta"><button class="ib" type="button" id="prP" aria-label="Previous project"><i class="fa-solid fa-arrow-left"></i></button><button class="ib" type="button" id="prN" aria-label="Next project"><i class="fa-solid fa-arrow-right"></i></button><button class="btn btn-s btn-o" type="button" id="prX">Close <kbd>Esc</kbd></button></div></div><div class="pres-v">${viewHTML(p,i)}</div><div class="pres-d"><span class="tag lbl">${esc(p.tag)}</span><h2>${esc(p.t)}</h2><p>${esc(p.d)}</p>${kstHTML(p)}<ul class="chips">${p.tech.map(t=>`<li>${esc(t)}</li>`).join('')}</ul><p class="px-m"><i class="fa-solid fa-layer-group"></i> ${esc(p.cat)} &nbsp;·&nbsp; <i class="fa-solid fa-user"></i> Developed by Jena Benisse Redondo</p><div class="cta">${p.link?`<a class="btn" href="${p.link[0]}" target="_blank" rel="noopener"><i class="fa-solid ${p.link[2]}"></i> ${p.link[1]}</a>`:''}<a class="btn btn-o" href="#contact" id="prC"><i class="fa-solid fa-paper-plane"></i> Discuss this project</a></div></div>`;
  $('#prX').onclick=()=>closePres();$('#prP').onclick=()=>stepP(-1);$('#prN').onclick=()=>stepP(1);
  if(p.shots){$$('.pres-v .shots img').forEach(im=>im.onclick=()=>openL(p.shots.map((s,k)=>({u:s,t:p.t+' — '+p.caps[k],k:'img'})),+im.dataset.k))}}
const stepP=d=>{const all=P.map((p,i)=>i),n=all[(presI+d+all.length)%all.length];drawPres(n);if(vis().includes(n))showP(n);$('#prX').focus()};
function openPres(i,e){presFocus=document.activeElement;const x=e&&e.clientX?e.clientX:innerWidth/2,y=e&&e.clientY?e.clientY:innerHeight/2;pres.style.setProperty('--ox',x+'px');pres.style.setProperty('--oy',y+'px');drawPres(i);clearTimeout(presT);pres.hidden=false;void pres.offsetWidth;if(!pres.classList.contains('open'))lock(1);pres.classList.add('open');setTimeout(()=>$('#prX')&&$('#prX').focus(),RM?0:500);beep(500,.2,.04,'sawtooth',300)}
function closePres(instant,nofocus){if(!pres.classList.contains('open'))return;if(instant)pres.style.transition='none';pres.classList.remove('open');lock(0);presT=setTimeout(()=>{pres.hidden=true;pres.style.transition=''},instant?30:850);if(!nofocus&&presFocus&&document.contains(presFocus))presFocus.focus()}

/* ---------- 12 · certificates ---------- */
const C=[["HTML Essentials","Web Development","Cisco Networking Academy · August 11, 2026","pdf","Completed the HTML Essentials course through Cisco Networking Academy in collaboration with JS Institute. The course covered structured HTML documents, semantic elements, multimedia, hyperlinks, forms, accessibility, and the relationship between HTML, CSS, and JavaScript.",["HTML","Web Structure","Accessibility"],"Web"],
["Network Addressing & Basic Troubleshooting","Networking","Cisco Networking Academy · April 13, 2026","pdf","Completed training focused on physical and data-link layer communication, network media, IPv6 addressing, routers, switches, and troubleshooting basic network connectivity issues.",["IPv6","Routing","Troubleshooting"],"Networking"],
["Networking Basics","Networking","Cisco Networking Academy · March 29, 2026","pdf","Completed Networking Basics covering network communication, network types, components, standards and protocols, Ethernet communication, IPv4 and IPv6, routers, connectivity testing, and wireless router configuration.",["IPv4","IPv6","Ethernet"],"Networking"],
["Networking Devices & Basic Configuration","Network Configuration","Cisco Networking Academy · April 8, 2026","pdf","Completed coursework covering hierarchical network design, number systems, Ethernet switching, IPv4 subnetting, DNS, DHCP, transport-layer protocols, Cisco IOS, and building basic computer networks using Cisco devices.",["Cisco IOS","Subnetting","DHCP"],"Networking"],
["Network Support & Security","Network Support","Cisco Networking Academy · April 13, 2026","pdf","Completed training focused on effective network troubleshooting, help desk best practices, common network threats, vulnerabilities, endpoint attacks, and secure user access on a network.",["Troubleshooting","Security","Help Desk"],"Networking"],
["Network Technician Career Path","Career Path","Cisco Networking Academy · April 22, 2026","pdf","Completed the Network Technician Career Path covering network standards, Ethernet, IPv4 and IPv6, wireless configuration, switching, DNS and DHCP, transport protocols, routing, troubleshooting, and secure network access.",["Networking","Routing","Security"],"Networking"],
["Bridging Business and Technology for the Next Generation","IT Week Seminar","IT Week 2026, La Consolacion College Tanauan · March 21, 2026","jpg","Certificate of Participation for the seminar held in celebration of IT Week 2026 at La Consolacion College Tanauan. The seminar explored how business processes and emerging technology intersect, encouraging IT students to connect technical skills with real-world business needs.",["IT Week 2026","Business & Technology","Seminar"],"Events"],
["Design, Build, Innovate: The Robotics Experience","Robotics Workshop","ICT Week 2026, La Consolacion College Tanauan · 2026","jpg","Certificate of Participation for a robotics workshop presented by First Eduspec Inc. in partnership with La Consolacion College Tanauan during LCCT ICT Week 2026. The workshop introduced hands-on robotics concepts, giving students the chance to explore robotics design and building beyond regular web and database coursework.",["Robotics","Hands-on Workshop","ICT Week 2026"],"Events"]];
const cu=i=>`certificates/certificate-${i+1}.${C[i][3]}`,cItems=()=>C.map((x,i)=>({u:cu(i),t:x[0],k:x[3]==='pdf'?'pdf':'img'}));let cs=0,cf='All',cs2='';const cq=$('#cq');
$('#ctf').innerHTML=['All','Web','Networking','Events'].map((c,i)=>`<button type="button" class="${i?'':'on'}" data-f="${c}" aria-pressed="${!i}">${c==='All'?'All 8 certificates':c}</button>`).join('');
$('#strip').innerHTML=C.map((c,i)=>`<button type="button" role="option" aria-selected="false" data-i="${i}" aria-label="${pad(i+1)} ${esc(c[0])}"><b>${pad(i+1)}</b><img src="certificates/thumbs/t${i+1}.jpg" alt="" loading="lazy" width="660" height="510"></button>`).join('');
const cVis=()=>C.map((c,i)=>i).filter(i=>(cf==='All'||C[i][6]===cf)&&(!cs2||matches([C[i][0],C[i][1],C[i][2],C[i][4],C[i][5].join(' ')].join(' '),cs2)));
function showC(i,fresh){if(i===undefined)return;cs=i;const c=C[i],im=$('#cgImg');im.src=`certificates/thumbs/t${i+1}.jpg`;im.alt=c[0]+' certificate';im.classList.remove('sw');void im.offsetWidth;if(fresh!==false&&!RM)im.classList.add('sw');$('#cgNo').textContent=pad(i+1);
  $('#cgMeta').innerHTML=`<p class="cat">${esc(c[1])}</p><h3>${esc(c[0])}</h3><span class="is">${esc(c[2])}</span><p class="d">${esc(c[4])}</p><ul class="chips">${c[5].map(t=>`<li>${esc(t)}</li>`).join('')}</ul><div class="cta"><button class="btn" type="button" data-cv="${i}" data-mag><i class="fa-solid fa-eye"></i> View</button><a class="btn btn-o" href="${cu(i)}" download data-mag><i class="fa-solid fa-download"></i> Download</a><a class="btn btn-o" href="${cu(i)}" target="_blank" rel="noopener" data-mag><i class="fa-solid fa-arrow-up-right-from-square"></i> Open</a></div>`;
  $$('#strip button').forEach(b=>{const on=+b.dataset.i===i;b.setAttribute('aria-selected',on);b.tabIndex=on?0:-1});const sel=$(`#strip button[data-i="${i}"]`);if(sel&&sel.scrollIntoView&&fresh!==false)sel.scrollIntoView({block:'nearest',inline:'center',behavior:RM?'auto':'smooth'})}
function cApply(){const v=cVis();$$('#strip button').forEach(x=>x.classList.toggle('gone',!v.includes(+x.dataset.i)));$('#cEmpty').hidden=v.length>0;$('#cgal').classList.toggle('gone',!v.length);if(v.length&&!v.includes(cs))showC(v[0])}
const stepC=d=>{const v=cVis();if(!v.length)return;showC(v[(Math.max(0,v.indexOf(cs))+d+v.length)%v.length])};
$('#cgPrev').onclick=()=>stepC(-1);$('#cgNext').onclick=()=>stepC(1);
$('#strip').onclick=e=>{const b=e.target.closest('button');if(b)showC(+b.dataset.i)};
$('#strip').onkeydown=e=>{const v=cVis(),p=v.indexOf(cs);let n=null;if(e.key==='ArrowRight')n=v[Math.min(v.length-1,p+1)];if(e.key==='ArrowLeft')n=v[Math.max(0,p-1)];if(n!==null&&n!==undefined){e.preventDefault();showC(n);$(`#strip button[data-i="${n}"]`).focus()}};
$('#ctf').onclick=e=>{const b=e.target.closest('button');if(!b)return;cf=b.dataset.f;$$('#ctf button').forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)});cApply()};
cq.oninput=()=>{cs2=cq.value.trim();cApply()};
$('#cgPaper').onclick=()=>openL(cItems(),cs,$('#cgPaper'));$('#cgMeta').onclick=e=>{const v=e.target.closest('[data-cv]');if(v)openL(cItems(),+v.dataset.cv,v)};
$('#cgPaper').addEventListener('pointermove',e=>{if(!FINE||RM)return;const r=e.currentTarget.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;e.currentTarget.style.transform=`rotateY(${x*10}deg) rotateX(${-y*10}deg)`});$('#cgPaper').addEventListener('pointerleave',e=>e.currentTarget.style.transform='');
showC(0,false);

/* ---------- 13 · viewer: documents + zoomable images ---------- */
const lb=$('#lb'),li=$('#li'),lst=$('#lst');let L=[],lci=0,lbFocus,lbT,Z={z:1,x:0,y:0};
function zApply(){const bw=li.offsetWidth,bh=li.offsetHeight,mx=Math.max(0,(bw*Z.z-lst.clientWidth)/2),my=Math.max(0,(bh*Z.z-lst.clientHeight)/2);Z.x=Math.max(-mx,Math.min(mx,Z.x));Z.y=Math.max(-my,Math.min(my,Z.y));li.style.setProperty('--z',Z.z);li.style.setProperty('--tx',Z.x+'px');li.style.setProperty('--ty',Z.y+'px');li.classList.toggle('zoomed',Z.z>1);$('#lzr').textContent=Math.round(Z.z*100)+'%'}
function zSet(z){Z.z=Math.max(1,Math.min(5,z));if(Z.z===1){Z.x=0;Z.y=0}zApply()}
const zReset=()=>{Z={z:1,x:0,y:0};zApply()};
$('#lzi').onclick=()=>zSet(Z.z*1.3);$('#lzo').onclick=()=>zSet(Z.z/1.3);$('#lzr').onclick=zReset;
lst.addEventListener('wheel',e=>{if(li.hidden)return;e.preventDefault();zSet(Z.z*(e.deltaY<0?1.15:1/1.15))},{passive:false});
li.addEventListener('dblclick',()=>Z.z>1?zReset():zSet(2.5));
const pts=new Map();let pinch=0,pan=null;
lst.addEventListener('pointerdown',e=>{if(li.hidden)return;pts.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pts.size===2){const [a,b]=[...pts.values()];pinch=Math.hypot(a.x-b.x,a.y-b.y);pan=null}else if(Z.z>1){pan={x:e.clientX,y:e.clientY,ox:Z.x,oy:Z.y};li.classList.add('panning')}});
lst.addEventListener('pointermove',e=>{if(!pts.has(e.pointerId))return;pts.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pts.size===2){const [a,b]=[...pts.values()],d=Math.hypot(a.x-b.x,a.y-b.y);if(pinch)zSet(Z.z*d/pinch);pinch=d}else if(pan){Z.x=pan.ox+e.clientX-pan.x;Z.y=pan.oy+e.clientY-pan.y;zApply()}});
const pend=e=>{pts.delete(e.pointerId);if(pts.size<2)pinch=0;if(!pts.size){pan=null;li.classList.remove('panning')}};lst.addEventListener('pointerup',pend);lst.addEventListener('pointercancel',pend);
function showL(i){lci=(i+L.length)%L.length;const it=L[lci],pdf=it.k==='pdf';$('#lt').textContent=it.t;$('#lcnt').textContent=L.length>1?(lci+1)+' / '+L.length:'';const d=$('#ld2');d.href=it.u;if(it.dl)d.setAttribute('download',it.dl);else d.setAttribute('download','');$('#lo').href=it.u;$('#lf').hidden=!pdf;li.hidden=pdf;lb.classList.toggle('is-img',!pdf);zReset();if(pdf){$('#lf').src=it.u}else{li.src=it.u;li.alt=it.t;$('#lf').src='about:blank'}}
function openL(list,i,from){L=list;clearTimeout(lbT);lbFocus=from||document.activeElement;showL(i);lb.hidden=false;void lb.offsetWidth;if(!lb.classList.contains('open'))lock(1);lb.classList.add('open');lb.classList.toggle('multi',L.length>1);$('#lc').focus();beep(600,.12,.04,'triangle',200)}
function closeL(instant){if(!lb.classList.contains('open'))return;lb.classList.remove('open');lock(0);lbT=setTimeout(()=>{lb.hidden=true;$('#lf').src='about:blank'},instant?0:360);if(!instant&&lbFocus&&lbFocus.focus&&document.contains(lbFocus))lbFocus.focus()}
$('#lc').onclick=()=>closeL();lb.onclick=e=>{if(e.target===lb)closeL()};$('#lbp').onclick=()=>showL(lci-1);$('#lbn').onclick=()=>showL(lci+1);
li.addEventListener('load',zApply);
document.addEventListener('click',e=>{const v=e.target.closest('[data-v]');if(v){const[u,t,k]=v.dataset.v.split('|');openL([u===CV.u?CV:{u,t,k}],0,v);return}
  const z=e.target.closest('img[data-zoom]');if(z){const all=$$('img[data-zoom]');openL(all.map(im=>({u:im.getAttribute('src'),t:im.dataset.zoom,k:'img'})),all.indexOf(z),z)}});

/* ---------- 14 · CV live preview ---------- */
$('#cvTog').onclick=()=>{if(navigator.pdfViewerEnabled===false){openL([CV],0,$('#cvTog'));toast('Your browser opens PDFs in the viewer instead.');return}
  const box=$('#cvPrev'),open=box.hidden;box.hidden=!open;$('#cvTog').setAttribute('aria-expanded',open);$('#cvTog span').textContent=open?'Hide preview':'Live preview';
  if(open){const f=$('#cvFrame');if(!f.getAttribute('src'))f.setAttribute('src',CV.u+'#view=FitH');setTimeout(()=>box.scrollIntoView({behavior:RM?'auto':'smooth',block:'start'}),60)}};

/* ---------- 15 · FAQ: animated, searchable accordion ---------- */
const FQ=$$('#faq-l details');
function faqToggle(d,force){const open=force!==undefined?force:!d.open,a=$('.fa',d);if(open===d.open&&!d.classList.contains('closing'))return;a.getAnimations().forEach(x=>x.cancel());d.classList.remove('closing');
  if(RM){d.open=open;faqAllState();return}
  if(open){d.open=true;const h=a.offsetHeight;a.animate([{height:'0px',opacity:0},{height:h+'px',opacity:1}],{duration:380,easing:'cubic-bezier(.2,.8,.2,1)'})}
  else{d.classList.add('closing');const h=a.offsetHeight,an=a.animate([{height:h+'px',opacity:1},{height:'0px',opacity:0}],{duration:300,easing:'cubic-bezier(.2,.8,.2,1)'});an.onfinish=()=>{d.open=false;d.classList.remove('closing');faqAllState()}}
  faqAllState()}
function faqAllState(){const vis2=FQ.filter(d=>!d.classList.contains('gone')),all=vis2.length&&vis2.every(d=>d.open&&!d.classList.contains('closing'));const b=$('#faqAll');b.setAttribute('aria-pressed',all);$('span',b).textContent=all?'Collapse all':'Expand all'}
$('#faq-l').addEventListener('click',e=>{const s=e.target.closest('summary');if(!s)return;e.preventDefault();faqToggle(s.parentElement)});
$('#faq-l').addEventListener('keydown',e=>{const s=e.target.closest&&e.target.closest('summary');if(!s)return;const vs=FQ.filter(d=>!d.classList.contains('gone')).map(d=>$('summary',d)),i=vs.indexOf(s);if(e.key==='ArrowDown'&&vs[i+1]){vs[i+1].focus();e.preventDefault()}else if(e.key==='ArrowUp'&&vs[i-1]){vs[i-1].focus();e.preventDefault()}else if(e.key==='Home'){vs[0].focus();e.preventDefault()}else if(e.key==='End'){vs[vs.length-1].focus();e.preventDefault()}});
$('#faqAll').onclick=()=>{const vs=FQ.filter(d=>!d.classList.contains('gone')),all=vs.every(d=>d.open);vs.forEach(d=>faqToggle(d,!all))};
$('#fq').oninput=()=>{const q=$('#fq').value.trim();let n=0,last=null;FQ.forEach(d=>{const hit=!q||matches(d.textContent,q);d.classList.toggle('gone',!hit);if(hit){n++;last=d}});$('#fEmpty').hidden=n>0;if(q&&n===1)faqToggle(last,true);faqAllState()};
function faqOpen(i){go('faq');setTimeout(()=>{$('#fq').value='';$('#fq').oninput();const d=FQ[i];faqToggle(d,true);d.scrollIntoView({behavior:RM?'auto':'smooth',block:'center'});$('summary',d).focus({preventScroll:true})},RM?80:1000)}
faqAllState();

/* ---------- 16 · contact ---------- */
function confetti(b){if(RM||!b)return;const c=document.createElement('canvas');c.style.cssText='position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:2300';c.width=innerWidth;c.height=innerHeight;document.body.append(c);const x=c.getContext('2d'),r=b.getBoundingClientRect(),cols=['#34d17f','#e8f3e6','#8ee86a','#8a9a3f'],Pt=Array.from({length:80},()=>({x:r.left+r.width/2,y:r.top,vx:(Math.random()-.5)*12,vy:-Math.random()*13-3,s:Math.random()*6+3,c:cols[Math.random()*4|0],a:1}));(function f(){x.clearRect(0,0,c.width,c.height);let al=0;Pt.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.35;p.a-=.012;if(p.a>0){al++;x.globalAlpha=p.a;x.fillStyle=p.c;x.fillRect(p.x,p.y,p.s,p.s*.6)}});al?requestAnimationFrame(f):c.remove()})()}
$('#copy').onclick=copyEmail;$$('[data-act=vcard]').forEach(b=>b.onclick=vcard);
document.addEventListener('click',e=>{const b=e.target.closest('[data-copy]');if(b)copyText(b.dataset.copy,b.dataset.what||'Text',b)});
$('#cf').onsubmit=e=>{e.preventDefault();const n=$('#fn'),m=$('#fe'),g=$('#fm');let ok=1;[n,m,g].forEach(i=>{const bad=!i.value.trim()||(i===m&&!/^\S+@\S+\.\S+$/.test(i.value));i.classList.toggle('bad',bad);i.setAttribute('aria-invalid',bad);if(bad)ok=0});if(!ok){toast('Please complete the highlighted fields');return}
  const sub=encodeURIComponent('Portfolio inquiry: '+$('#ft').value+' — '+n.value.trim()),body=encodeURIComponent('Hi Jena,\n\n'+g.value.trim()+'\n\nI’m interested in: '+$('#ft').value+'\n\nFrom: '+n.value.trim()+' ('+m.value.trim()+')');location.href='mailto:'+EMAIL+'?subject='+sub+'&body='+body;toast('Opening your email app…')};

/* ---------- 17 · discovery map ---------- */
const mapStage=$('#mapStage'),mapSvg=$('#mapLines');let mapPos=[],mapSats=[],mapOpenId=null;
function satsFor(id){if(id==='projects')return P.map((p,i)=>({l:p.t,ic:'fa-laptop-code',run:()=>{go('projects');setTimeout(()=>{pq.value='';ps='';pf='all';$$('#fl button').forEach((x,k)=>{x.classList.toggle('on',k===0);x.setAttribute('aria-pressed',k===0)});showP(i);openPres(i)},RM?60:900)}}));
  if(id==='certificates')return C.map((c,i)=>({l:c[0],ic:'fa-award',run:()=>{go('certificates');setTimeout(()=>{cq.value='';cs2='';cf='All';$$('#ctf button').forEach((x,k)=>x.classList.toggle('on',k===0));cApply();showC(i);openL(cItems(),i,$('#cgPaper'))},RM?60:900)}}));
  if(id==='skills')return S.map(s=>({l:s[0],ic:s[2],run:()=>{go('skills');setTimeout(()=>{skF=s[1];skS=s[0];skRender()},RM?60:900)}}));
  if(id==='faq')return FQ.map((d,i)=>({l:$('summary',d).textContent,ic:'fa-solid fa-circle-question',run:()=>faqOpen(i)}));
  return[]}
function buildMap(){mapOpenId=null;const w=mapStage.clientWidth||1000,h=mapStage.clientHeight||600,wide=w/h>1.05;
  const cols=wide?[11,37,63,89]:[17,50,83],rows=wide?[20,50,80]:[11,37,63,89],n=RECS.length;mapPos=[];
  RECS.forEach((r,i)=>{const row=Math.floor(i/cols.length),k=i%cols.length,c=row%2?cols.length-1-k:k;mapPos.push([cols[c],rows[row]+(i%2?4:-4)])});
  const d=mapPos.map((p,i)=>{if(!i)return`M${p[0]} ${p[1]}`;const q=mapPos[i-1],mx=(p[0]+q[0])/2,my=(p[1]+q[1])/2;return`Q${q[0]} ${q[1]} ${mx} ${my}`}).join(' ')+` T${mapPos[n-1][0]} ${mapPos[n-1][1]}`;
  mapSvg.setAttribute('viewBox','0 0 100 100');mapSvg.innerHTML=`<path d="${d}"></path><g id="mapSatLines"></g>`;
  $$('.mn',mapStage).forEach(x=>x.remove());
  mapStage.insertAdjacentHTML('beforeend',RECS.map((r,i)=>`<button type="button" class="mn sec ${i===curI?'here':''}" data-id="${r[0]}" style="left:${mapPos[i][0]}%;top:${mapPos[i][1]}%" aria-label="${esc(r[1])}${satsFor(r[0]).length?' — select to show items, select again to open':''}" ${satsFor(r[0]).length?'aria-expanded="false"':''}><span class="dot"><b>${pad(i+1)}</b></span><span class="t">${esc(r[1])}</span></button>`).join(''));
  $('#mapHint').textContent='Nothing selected yet.'}
function mapSat(id){$$('.mn.sat',mapStage).forEach(x=>x.remove());$('#mapSatLines').innerHTML='';mapSats=[];$$('.mn.sec',mapStage).forEach(x=>{x.classList.remove('open');if(x.hasAttribute('aria-expanded'))x.setAttribute('aria-expanded','false')});if(!id)return;
  const i=RECS.findIndex(r=>r[0]===id),list=satsFor(id),w=mapStage.clientWidth,h=mapStage.clientHeight,px=mapPos[i][0]/100*w,py=mapPos[i][1]/100*h,R=Math.min(190,Math.max(110,Math.min(w,h)*.3)),cl=(v,a,b)=>Math.max(a,Math.min(b,v));
  const sec=$(`.mn.sec[data-id="${id}"]`);sec.classList.add('open');sec.setAttribute('aria-expanded','true');
  let html='',ln='';list.forEach((s,k)=>{const a=-Math.PI/2+k/list.length*Math.PI*2,rr=R*(list.length>9?1.1:1),x=cl((px+Math.cos(a)*rr)/w*100,5,95),y=cl((py+Math.sin(a)*rr)/h*100,6,94);mapSats.push(s);
    ln+=`<line x1="${mapPos[i][0]}" y1="${mapPos[i][1]}" x2="${x}" y2="${y}"></line>`;html+=`<button type="button" class="mn sat" data-k="${k}" style="left:${x}%;top:${y}%" aria-label="${esc(s.l)}"><span class="dot"><i class="${s.ic.includes(' ')?s.ic:'fa-solid '+s.ic}"></i></span><span class="t">${esc(s.l)}</span></button>`});
  $('#mapSatLines').innerHTML=ln;mapStage.insertAdjacentHTML('beforeend',html);void mapStage.offsetWidth;$$('.mn.sat',mapStage).forEach((x,k)=>setTimeout(()=>x.classList.add('show'),RM?0:k*45));
  $('#mapHint').textContent=list.length+' from “'+RECS[i][1]+'”. Select one to open it, or select '+RECS[i][1]+' again to go to the section.'}
mapStage.addEventListener('click',e=>{const b=e.target.closest('.mn');if(!b)return;
  if(b.classList.contains('sat')){const s=mapSats[+b.dataset.k];MAP.hide(false,true);setTimeout(s.run,RM?30:400);return}
  const id=b.dataset.id;if(satsFor(id).length&&mapOpenId!==id){mapOpenId=id;mapSat(id);return}
  mapOpenId=null;MAP.hide(false,true);setTimeout(()=>go(id),RM?30:350)});
const mapHover=e=>{const b=e.target.closest&&e.target.closest('.mn');if(!b)return;if(b.classList.contains('sec')){const r=RECS.find(x=>x[0]===b.dataset.id);if(!mapOpenId)$('#mapHint').textContent=r[1]+' — '+r[2]}else $('#mapHint').textContent=mapSats[+b.dataset.k].l};
mapStage.addEventListener('mouseover',mapHover);mapStage.addEventListener('focusin',mapHover);
$('#mapRand').onclick=()=>{const pool=[];['projects','certificates','skills','faq'].forEach(id=>satsFor(id).forEach(s=>pool.push(s)));const s=pool[Math.random()*pool.length|0];toast('Surprise: '+s.l);MAP.hide(false,true);setTimeout(s.run,RM?30:420)};
let mapRz;addEventListener('resize',()=>{if(!MAP.open)return;clearTimeout(mapRz);mapRz=setTimeout(()=>{const o=mapOpenId;buildMap();if(o){mapOpenId=o;mapSat(o)}},150)});

/* ---------- 18 · cursor · keyboard · easter eggs ---------- */
if(FINE){const cur=$('#cur'),ring=$('.cur-ring',cur),dot=$('.cur-dot',cur),lab=$('#curl');let tx0=0,ty0=0,x=0,y=0;
  addEventListener('mousemove',e=>{tx0=e.clientX;ty0=e.clientY;cur.classList.add('on');const t=e.target.closest&&e.target.closest('[data-cursor]');const big=e.target.closest&&e.target.closest('a,button,summary,input,select,textarea,[role=button],.ms-b');cur.classList.toggle('lab',!!t);cur.classList.toggle('big',!!big&&!t);lab.textContent=t?t.dataset.cursor:'';
    const m=e.target.closest&&e.target.closest('[data-mag]');if(m&&!RM){const r=m.getBoundingClientRect();m.style.setProperty('--mx',((e.clientX-r.left-r.width/2)*.2)+'px');m.style.setProperty('--my',((e.clientY-r.top-r.height/2)*.3)+'px')}},{passive:true});
  document.addEventListener('mouseout',e=>{const m=e.target.closest&&e.target.closest('[data-mag]');if(m&&!m.contains(e.relatedTarget)){m.style.setProperty('--mx','0px');m.style.setProperty('--my','0px')}});
  document.addEventListener('mouseleave',()=>cur.classList.remove('on'));
  (function f(){x+=(tx0-x)*.2;y+=(ty0-y)*.2;dot.style.transform=`translate(${tx0}px,${ty0}px)`;ring.style.transform=`translate(${x}px,${y}px)`;requestAnimationFrame(f)})()}
/* secret garden: leaves fall (Konami code, or tap the JBR mark five times) */
const bl=$('#bloom'),bx=bl.getContext('2d');let blRun=false;
function bloom(){if(RM){toast('You found the secret garden. Thanks for exploring!');return}toast('You found the secret garden. Thanks for exploring!');bl.width=innerWidth;bl.height=innerHeight;const cols=['#34d17f','#8ee86a','#8a9a3f','#cfeedd','#1fa46a'],lv=Array.from({length:110},()=>({x:Math.random()*bl.width,y:-Math.random()*bl.height*.6,s:7+Math.random()*12,v:1.2+Math.random()*2.6,sw:Math.random()*6.28,r:Math.random()*6.28,c:cols[Math.random()*5|0]}));if(blRun)return;blRun=true;let T=0;
  (function f(){T++;bx.clearRect(0,0,bl.width,bl.height);let alive=0;lv.forEach(l=>{l.y+=l.v;l.sw+=.04;l.x+=Math.sin(l.sw)*1.4;l.r+=.03;if(l.y<bl.height+30){alive++;bx.save();bx.translate(l.x,l.y);bx.rotate(l.r);bx.fillStyle=l.c;bx.beginPath();bx.moveTo(0,-l.s);bx.quadraticCurveTo(l.s*.8,0,0,l.s);bx.quadraticCurveTo(-l.s*.8,0,0,-l.s);bx.fill();bx.restore()}});if(alive&&T<700)requestAnimationFrame(f);else{bx.clearRect(0,0,bl.width,bl.height);blRun=false}})()}
let taps=0,tapT;$('#brand').addEventListener('click',()=>{taps++;clearTimeout(tapT);tapT=setTimeout(()=>taps=0,2000);if(taps>=5){taps=0;bloom()}});
const KON=['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];let kp=0;
function isTyping(t){return t&&(/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)||t.isContentEditable)}
addEventListener('keydown',e=>{const k=e.key;
  if(!introDone){if(k==='Escape'||k==='Enter')endIntro();return}
  if(lb.classList.contains('open')){if(k==='Escape')closeL();else if(L.length>1&&k==='ArrowLeft')showL(lci-1);else if(L.length>1&&k==='ArrowRight')showL(lci+1);else if(!li.hidden&&(k==='+'||k==='='))zSet(Z.z*1.3);else if(!li.hidden&&(k==='-'||k==='_'))zSet(Z.z/1.3);else if(!li.hidden&&k==='0')zReset();else trap(e,lb);return}
  if(CMP.open){if(k==='Escape')CMP.hide();else trap(e,$('#cmp'));return}
  if(pres.classList.contains('open')){if(k==='Escape')closePres();else if(k==='ArrowLeft')stepP(-1);else if(k==='ArrowRight')stepP(1);else trap(e,pres);return}
  if(MAP.open){if(k==='Escape')MAP.hide();else if(k==='Tab')trap(e,$('#map'));return}
  if(IDX.open){if(k==='Escape'){IDX.hide();return}if(k==='Tab'){trap(e,$('#idx'));return}
    const t=$$('#idxGrid li:not(.gone) a,#idxRes button,#idxAct button:not(.gone)').filter(x=>x.offsetParent!==null),i=t.indexOf(document.activeElement),inp=document.activeElement===$('#idxq');
    if(k==='Enter'&&inp){e.preventDefault();const g=$('#idxRes button')||(!$('#idxq').value.trim()&&t[0]);g&&g.click();return}
    if(k==='ArrowDown'||k==='ArrowRight'){if(k==='ArrowRight'&&inp)return;const n=inp?0:i+1;if(t[n]){t[n].focus();e.preventDefault()}}
    else if(k==='ArrowUp'||k==='ArrowLeft'){if(k==='ArrowLeft'&&inp)return;if(i<=0){$('#idxq').focus();e.preventDefault()}else{t[i-1].focus();e.preventDefault()}}
    return}
  if((e.ctrlKey||e.metaKey)&&k.toLowerCase()==='k'){e.preventDefault();IDX.show(idxb);return}
  if(e.ctrlKey||e.metaKey||e.altKey||isTyping(e.target))return;
  if(k===KON[kp]||k.toLowerCase()===KON[kp]){kp++;if(kp===KON.length){kp=0;bloom()}}else kp=(k===KON[0])?1:0;
  if(k==='/'){e.preventDefault();IDX.show(idxb)}else if(k==='i'||k==='I')IDX.show(idxb);else if(k==='g'||k==='G')MAP.show($('#mapB'));else if(k==='[')jump(-1);else if(k===']')jump(1);else if(k==='t'||k==='T')flip();else if(k==='m'||k==='M')toggleSound();
  else if(/^[0-9]$/.test(k)){const n=k==='0'?9:+k-1;if(RECS[n])go(RECS[n][0])}});

/* ---------- 19 · init ---------- */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;e.target.classList.add('in');io.unobserve(e.target);if(e.target.id==='ledger')$$('[data-n]',e.target).forEach(countUp);if(e.target.classList.contains('dos'))typeTerm()}),{threshold:.12,rootMargin:'0px 0px -6% 0px'});
$$('[data-split]').forEach(h=>{const t=h.textContent.trim();h.setAttribute('aria-label',t);let i=0;h.innerHTML=t.split(/\s+/).map(w=>`<span class="wd" aria-hidden="true">${[...w].map(c=>`<span class="ch" style="--i:${i++}">${esc(c)}</span>`).join('')}</span>`).join('')});
$$('.rv,.rt,#ledger').forEach(e=>io.observe(e));
if(!('IntersectionObserver'in window))$$('.rv,.rt').forEach(e=>e.classList.add('in'));
buildEntries();setMode('calm',root.classList.contains('calm'),true);setMode('comfy',root.classList.contains('comfy'),true);
setTheme(root.dataset.theme,false);applyAcc();sizeField();fieldColor();requestAnimationFrame(loopField);setCur(0);onScroll();
runIntro();
if(introDone&&location.hash&&document.getElementById(location.hash.slice(1)))addEventListener('load',()=>setTimeout(()=>scrollTo({top:topOf(document.getElementById(location.hash.slice(1))),behavior:'instant'}),80));
})();
