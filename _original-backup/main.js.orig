const S=[["HTML","Frontend","fa-brands fa-html5","Creating structured and semantic web pages and interfaces."],["CSS","Frontend","fa-brands fa-css3-alt","Designing responsive, clean, and modern user interfaces."],["JavaScript","Frontend","fa-brands fa-js","Creating interactive features and dynamic web functionality."],["PHP","Backend","fa-brands fa-php","Developing dynamic web applications and backend logic."],["MySQL","Database","fa-solid fa-database","Managing, organizing, and connecting application data."],["Networking","Networking","fa-solid fa-network-wired","Understanding addressing, devices, protocols, configuration, and troubleshooting."],["UI/UX Design","Frontend","fa-solid fa-pen-ruler","Applying design concepts to build clear, user-friendly interfaces."],["Programming","Backend","fa-solid fa-terminal","Solving problems with code across academic and personal projects."],["System Development","Backend","fa-solid fa-gears","Building complete systems — from database to interface."],["Microsoft Office Suite","Productivity","fa-solid fa-file-word","Documents, spreadsheets, and presentations for everyday work."],["Robotics","Exploration","fa-solid fa-robot","Exploring robotics concepts through workshop-based learning and hands-on activities."]];
const CATS=['Frontend','Backend','Database','Networking','Productivity','Exploration'],CIC={Frontend:'fa-window-maximize',Backend:'fa-server',Database:'fa-database',Networking:'fa-network-wired',Productivity:'fa-file-word',Exploration:'fa-robot'},CAN={Frontend:-90,Backend:-30,Database:30,Networking:90,Productivity:150,Exploration:210};
const stage=$('#skStage'),svg=$('#skLines');let nodes=[],lines=[],skF='All',skS=null;
(function buildSky(){const pt=(a,r,cx0=50,cy0=50)=>[cx0+r*Math.cos(a*Math.PI/180),cy0+r*Math.sin(a*Math.PI/180)],cl=v=>Math.max(8,Math.min(92,v));
  nodes.push({k:'core',x:50,y:50,cat:null});
  CATS.forEach(c=>{const a=CAN[c],[x,y]=pt(a,25),sk=S.filter(s=>s[1]===c);nodes.push({k:'cat',n:c,x,y,cat:c});lines.push({a:[50,50],b:[x,y],cat:c,to:c});
    sk.forEach((s,i)=>{const off=sk.length>1?(i-(sk.length-1)/2)*(sk.length>3?36:44):0,[sx,sy]=pt(a+off,sk.length>3?17:16,x,y),X=cl(sx),Y=cl(sy);nodes.push({k:'sk',n:s[0],x:X,y:Y,cat:c,s});lines.push({a:[x,y],b:[X,Y],cat:c,to:s[0]})})});
  svg.setAttribute('viewBox','0 0 100 100');svg.innerHTML=lines.map(l=>`<line x1="${l.a[0]}" y1="${l.a[1]}" x2="${l.b[0]}" y2="${l.b[1]}" data-c="${l.cat}" data-t="${esc(l.to)}"></line>`).join('');
  stage.insertAdjacentHTML('beforeend',nodes.map((n,i)=>n.k==='core'?`<div class="nd core" style="left:50%;top:50%"><span class="nd-c">JBR.</span><em>BSIT · Developer</em></div>`:`<button type="button" class="nd ${n.k==='sk'?'sk':'cat'}" data-i="${i}" style="left:${n.x}%;top:${n.y}%" aria-label="${n.k==='sk'?esc(n.n)+' — '+n.cat+' skill':esc(n.n)+' cluster'}"><span class="nd-c"><i class="${n.k==='sk'?n.s[2]:'fa-solid '+CIC[n.n]}"></i></span><em>${esc(n.n)}</em></button>`).join(''));
  $('#stabs').innerHTML=['All',...CATS].map((c,i)=>`<button type="button" class="${i?'':'on'}" data-s="${c}">${c}</button>`).join('')})();
const techU=['HTML','CSS','JavaScript','PHP','MySQL','CRUD','GitHub','Networking','Cisco','Robotics','UI/UX','MS Office'];$('#skU').innerHTML=techU.map(t=>`<li>${t}</li>`).join('');
function skRender(){$$('.nd',stage).forEach((el,i)=>{const n=nodes[i];if(!n)return;el.classList.toggle('dim',skF!=='All'&&n.k!=='core'&&n.cat!==skF);el.classList.toggle('sel',!!skS&&n.n===skS||(skF!=='All'&&n.k==='cat'&&n.n===skF&&!skS));if(n.k!=='core')el.setAttribute('aria-pressed',el.classList.contains('sel'))});
  $$('line',svg).forEach(l=>{const inCat=skF!=='All'&&l.dataset.c===skF,isSel=skS&&(l.dataset.t===skS||l.dataset.t===S.find(s=>s[0]===skS)[1]);l.classList.toggle('dim',skF!=='All'&&!inCat);l.classList.toggle('hot',!!inCat&&!skS||!!isSel)});
  $$('#stabs button').forEach(b=>b.classList.toggle('on',b.dataset.s===skF));
  if(skS){const s=S.find(x=>x[0]===skS);$('#skCat').textContent='Cluster · '+s[1];$('#skName').textContent=s[0];$('#skDesc').textContent=s[3]}
  else if(skF!=='All'){$('#skCat').textContent='Cluster · '+skF;$('#skName').textContent=skF;$('#skDesc').textContent='Skills in this cluster: '+S.filter(s=>s[1]===skF).map(s=>s[0]).join(', ')+'.'}
  else{$('#skCat').textContent='Cluster · All';$('#skName').textContent='Pick a node';$('#skDesc').textContent='Select any skill in the constellation to read how I use it. Use the clusters to filter.'}}
stage.addEventListener('click',e=>{const b=e.target.closest('.nd[data-i]');if(!b)return;const n=nodes[+b.dataset.i];if(n.k==='cat'){skF=skF===n.n&&!skS?'All':n.n;skS=null}else{skF=n.cat;skS=n.n}skRender()});
$('#stabs').onclick=e=>{const b=e.target.closest('button');if(!b)return;skF=b.dataset.s;skS=null;skRender()};

