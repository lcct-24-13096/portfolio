const DECO=['','<div class="tiles">'+'<i></i>'.repeat(9)+'</div>','<span class="tk"></span>','<div class="rows">'+'<i></i>'.repeat(6)+'</div>','<div class="cal">'+Array.from({length:28},(_,k)=>`<i class="${[3,4,10,11,12,17,24].includes(k)?'f':''}"></i>`).join('')+'</div>','<div class="win"><i></i><i></i><i></i></div>'];
