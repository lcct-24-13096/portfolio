const TL=[['c','whoami'],['o','jena-benisse-redondo'],['c','cat role.txt'],['o','BSIT student · aspiring web & systems developer'],['c','ls skills/'],['o','html  css  javascript  php  mysql  networking  ui-ux'],['c','cat status.txt'],['s','open to learning & building',' — internships, collaborations, projects']];
const lineHTML=(l,n)=>{const full=l[1]+(l[2]||'');if(l[0]==='c')return'<b>$</b> '+esc(full.slice(0,n));if(l[0]==='o')return esc(full.slice(0,n));return'<u>'+esc(l[1].slice(0,n))+'</u>'+esc((l[2]||'').slice(0,Math.max(0,n-l[1].length)))};
let tDone=false;function typeTerm(){if(tDone)return;tDone=true;const el=$('#tp');if(RM){el.innerHTML=TL.map(l=>lineHTML(l,99)).join('\n');return}let li=0,ch=0,out='';(function ty(){if(li>=TL.length)return;const l=TL[li],len=(l[1]+(l[2]||'')).length;if(ch<=len){el.innerHTML=out+lineHTML(l,ch);ch++;setTimeout(ty,l[0]==='c'?42:12)}else{out+=lineHTML(l,len)+'\n';li++;ch=0;setTimeout(ty,l[0]==='c'?260:380)}})()}
