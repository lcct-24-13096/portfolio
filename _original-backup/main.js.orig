/* ---------- 8 · learning journey ---------- */
const jt=$('#jt'),ms=$$('.ms',jt);let moved=false;
$$('.ms-b',jt).forEach(b=>b.onclick=()=>{if(moved)return;b.setAttribute('aria-expanded',b.getAttribute('aria-expanded')!=='true')});
const jStep=()=>(ms[1].offsetLeft-ms[0].offsetLeft)||360;
$('#jNext').onclick=()=>jt.scrollBy({left:jStep(),behavior:RM?'auto':'smooth'});$('#jPrev').onclick=()=>jt.scrollBy({left:-jStep(),behavior:RM?'auto':'smooth'});
function jUpd(){const max=jt.scrollWidth-jt.clientWidth,i=Math.min(ms.length-1,Math.round(jt.scrollLeft/jStep()));$('#jCount').textContent=pad(i+1)+' / '+pad(ms.length);$('#jFill').style.transform=`scaleX(${max>0?.16+.84*jt.scrollLeft/max:1})`}
jt.addEventListener('scroll',jUpd,{passive:true});jUpd();
let dg=null;jt.addEventListener('pointerdown',e=>{if(e.pointerType!=='mouse'||e.button)return;dg={x:e.clientX,s:jt.scrollLeft}});
addEventListener('pointermove',e=>{if(!dg)return;const dx=e.clientX-dg.x;if(Math.abs(dx)>6){moved=true;jt.classList.add('drag')}if(moved)jt.scrollLeft=dg.s-dx});
addEventListener('pointerup',()=>{if(!dg)return;dg=null;jt.classList.remove('drag');setTimeout(()=>moved=false,0)});
jt.addEventListener('keydown',e=>{if(e.target!==jt)return;if(e.key==='ArrowRight'){jt.scrollBy({left:jStep(),behavior:'smooth'});e.preventDefault()}if(e.key==='ArrowLeft'){jt.scrollBy({left:-jStep(),behavior:'smooth'});e.preventDefault()}});
const CW=[[["Programming & Development","fa-code",["Computer Programming 1","Computer Programming 2","Object-Oriented Programming"]],["Data & Systems","fa-database",["Information Management 1","Data Structure and Algorithm","Software Engineering"]],["Networking","fa-network-wired",["Networking 101","Networking 102"]],["Design & Human Interaction","fa-pen-ruler",["Multimedia Systems","Introduction to Human Interaction"]],["Computing Foundations","fa-laptop",["Introduction to Computing","Social and Professional Issues"]]],[["Application Development & Emerging Technologies","fa-mobile-screen-button"],["Interactive Programming & Technologies","fa-diagram-project"],["IT Project Management","fa-list-check"],["Platform Technologies","fa-layer-group"],["Web System Technologies","fa-globe"]]];
const dCW=t=>$('#cw').innerHTML=CW[t].map((c,i)=>`<div class="${t?'now2':''}" style="--i:${i}"><i class="k fa-solid ${c[1]}"></i><h4>${esc(c[0])}</h4>${c[2]?`<ul>${c[2].map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:'<span class="mini">In Progress</span>'}</div>`).join('');dCW(0);
