/* =========================================================
   PORTFOLIO 2.0 — "The Digital Identity Garden" · main.js (vanilla, no dependencies)
   1 helpers · 2 theme/accent/modes/sound · 3 background field · 4 intro · 5 navigation + transitions
   6 overlays + command center · 7 hero/about · 8 journey · 9 work · 10 skills · 11 projects + compare
   12 certificates · 13 viewer (zoom) · 14 CV preview · 15 FAQ · 16 contact · 17 discovery map
   18 cursor · keyboard · easter eggs · 19 init
   ========================================================= */
(()=>{'use strict';
/* ---------- 1 · helpers ---------- */
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const root=document.documentElement,RM0=matchMedia('(prefers-reduced-motion: reduce)').matches,FINE=matchMedia('(hover:hover) and (pointer:fine)').matches;
let RM=RM0||root.classList.contains('calm');
const EMAIL='jenabenisseredondo523@gmail.com',LI='https://ph.linkedin.com/in/jena-benisse-redondo-267106449';
const CV={u:'resume/Jena-Redondo-Resume.pdf',t:'Curriculum Vitae — Jena Benisse Redondo',k:'pdf',dl:'Jena-Redondo-Curriculum-Vitae.pdf'};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const pad=n=>String(n).padStart(2,'0'),topOf=e=>e.getBoundingClientRect().top+scrollY;
const save=(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}},load=k=>{try{return localStorage.getItem(k)}catch(e){return null}};
let tt;const toast=m=>{const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(tt);tt=setTimeout(()=>t.classList.remove('on'),2400)};
let locks=0;const lock=on=>{locks=Math.max(0,locks+(on?1:-1));root.style.overflow=locks?'hidden':''};
const trap=(e,c)=>{if(e.key!=='Tab')return;const f=$$('a[href],button:not([disabled]),input,select,textarea,[tabindex="0"]',c).filter(x=>x.offsetParent!==null&&!x.closest('.gone')&&!x.closest('[hidden]'));if(!f.length)return;const a=f[0],z=f[f.length-1];if(e.shiftKey&&document.activeElement===a){z.focus();e.preventDefault()}else if(!e.shiftKey&&document.activeElement===z){a.focus();e.preventDefault()}};
const tokens=s=>s.toLowerCase().split(/\s+/).filter(Boolean);
const matches=(hay,q)=>{const t=tokens(q);const h=hay.toLowerCase();return t.every(w=>h.includes(w))};

const RECS=[['home','Home','Start here'],['about','About me','Story, strengths & education'],['journey','Learning journey','Timeline & coursework'],['work','What I build','Areas of work · OJT'],['skills','My skills','Skills constellation'],['projects','Featured projects','Project explorer'],['certificates','Certifications','Credential gallery'],['cv','Curriculum Vitae','Interactive document'],['presence','Professional presence','LinkedIn'],['interests','Personal interests','Beyond the code'],['faq','Quick answers','Recruiter Q&A'],['contact','Contact','Let’s connect']];
const SEC=RECS.map(r=>document.getElementById(r[0]));

/* ---------- 2 · theme · accent · viewing modes · sound ---------- */
const ACC={Emerald:['52,209,127','14,107,60'],Fern:['142,232,106','52,110,18'],Mint:['143,233,192','14,112,76'],Jade:['25,179,148','8,104,88']};
let accN=load('jbr-acc');if(!ACC[accN])accN='Emerald';
function applyAcc(){const s=root.style;if(accN==='Emerald'){['--acc','--acc-rgb','--acc-ink'].forEach(p=>s.removeProperty(p));return}const v=ACC[accN],d=root.dataset.theme==='dark';s.setProperty('--acc-rgb',v[0]);s.setProperty('--acc','rgb('+v[0]+')');s.setProperty('--acc-ink','rgb('+(d?v[0]:v[1])+')')}
function setTheme(t,anim){const run=()=>{root.dataset.theme=t;save('jbr-theme',t);$('#th i').className='fa-solid '+(t==='dark'?'fa-moon':'fa-sun');$('#th').setAttribute('aria-label','Switch to '+(t==='dark'?'light':'dark')+' mode');$('meta[name=theme-color]').content=t==='dark'?'#08180f':'#edf3e8';applyAcc();fieldColor()};
  if(anim&&document.startViewTransition&&!RM){const r=$('#th').getBoundingClientRect(),x=r.left+r.width/2,y=r.top+r.height/2,R=Math.hypot(Math.max(x,innerWidth-x),Math.max(y,innerHeight-y));
    try{const vt=document.startViewTransition(run);setTimeout(()=>{if(root.dataset.theme!==t)run()},600);vt.ready.then(()=>root.animate({clipPath:[`circle(0 at ${x}px ${y}px)`,`circle(${R}px at ${x}px ${y}px)`]},{duration:750,easing:'cubic-bezier(.76,0,.24,1)',pseudoElement:'::view-transition-new(root)'})).catch(()=>{})}catch(e){run()}}else run()}
const flip=()=>{setTheme(root.dataset.theme==='dark'?'light':'dark',true);beep(380,.12,.05,'triangle',-120)};
$('#th').onclick=flip;
/* viewing modes */
function setMode(name,on,quiet){root.classList.toggle(name,on);save('jbr-'+name,on?'on':'off');const b=$('#'+name+'T');b.setAttribute('aria-pressed',on);b.lastElementChild.textContent=on?'on':'off';
  if(name==='calm'){RM=RM0||on;if(RM)drawField(0,true)}
  if(!quiet)toast((name==='calm'?'Calm mode ':'Comfort text ')+(on?'on':'off'))}
$('#calmT').onclick=()=>setMode('calm',!root.classList.contains('calm'));$('#comfyT').onclick=()=>setMode('comfy',!root.classList.contains('comfy'));
let AC=null,snd=false;
function beep(f=520,d=.06,v=.035,type='sine',slide=0){if(!snd||!AC)return;try{const t=AC.currentTime,o=AC.createOscillator(),g=AC.createGain();o.type=type;o.frequency.setValueAtTime(f,t);if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(40,f+slide),t+d);g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+d)}catch(e){}}
function toggleSound(){snd=!snd;if(snd&&!AC){try{AC=new(window.AudioContext||window.webkitAudioContext)()}catch(e){snd=false}}
  if(AC&&AC.resume)AC.resume();const b=$('#snd');b.setAttribute('aria-pressed',snd);b.setAttribute('aria-label','Sound effects: '+(snd?'on (click to turn off)':'off (click to turn on)'));b.firstElementChild.className='fa-solid '+(snd?'fa-volume-high':'fa-volume-xmark');toast('Sound '+(snd?'on':'off'));beep(660,.12,.05,'sine',240)}
$('#snd').onclick=toggleSound;
let lastH=0;document.addEventListener('mouseover',e=>{if(!snd)return;const n=performance.now();if(n-lastH<90)return;if(e.target.closest('.btn,.ib,.px-list button,.idx-grid a,.strip button,.tabs button,.mn'))lastH=n,beep(900,.035,.015,'square')});
document.addEventListener('click',e=>{if(snd&&e.target.closest('button,a'))beep(520,.07,.03,'triangle',120)});

/* ---------- 3 · background field: ticks that lean toward the pointer ---------- */
const cv=$('#field'),cx=cv.getContext('2d');let W,H,GAP=34,tickC='170,225,185',accRgb='52,209,127';const ptr={x:-999,y:-999};
function fieldColor(){const cs=getComputedStyle(root);tickC=cs.getPropertyValue('--tick').trim()||'170,225,185';accRgb=cs.getPropertyValue('--acc-rgb').trim()||'52,209,127';if(RM)drawField(0,true)}
function sizeField(){const d=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;cx.setTransform(d,0,0,d,0,0);GAP=W<760?44:34;if(RM)drawField(0,true)}
let lastF=0;function drawField(t,force){if(!force&&t-lastF<32)return;lastF=t;cx.clearRect(0,0,W,H);cx.lineCap='round';const sy=(scrollY*.1)%GAP,has=ptr.x>-900;
  cx.lineWidth=1.4;cx.strokeStyle=`rgba(${tickC},.2)`;cx.beginPath();const near=[];
  for(let x=GAP/2;x<W+GAP;x+=GAP)for(let y=-GAP+sy;y<H+GAP;y+=GAP){const dx=ptr.x-x,dy=ptr.y-y,d=has?Math.hypot(dx,dy):9999,wv=Math.sin(t/2600+x*.008+y*.006)*.9+y*.002;
    let ang=wv,len=7;if(d<420){const w=Math.pow(1-d/420,.7),ta=Math.atan2(dy,dx);ang=Math.atan2(Math.sin(wv)*(1-w)+Math.sin(ta)*w,Math.cos(wv)*(1-w)+Math.cos(ta)*w);len=7+w*9}
    const ox=Math.cos(ang)*len,oy=Math.sin(ang)*len;
    if(d<190)near.push([x,y,ox,oy,1-d/190]);else{cx.moveTo(x-ox/2,y-oy/2);cx.lineTo(x+ox/2,y+oy/2)}}
  cx.stroke();cx.lineWidth=2;near.forEach(n=>{cx.strokeStyle=`rgba(${accRgb},${.25+n[4]*.7})`;cx.beginPath();cx.moveTo(n[0]-n[2]/2,n[1]-n[3]/2);cx.lineTo(n[0]+n[2]/2,n[1]+n[3]/2);cx.stroke()})}
function loopField(t){if(!document.hidden&&!RM)drawField(t);requestAnimationFrame(loopField)}
addEventListener('resize',sizeField);
addEventListener('pointermove',e=>{ptr.x=e.clientX;ptr.y=e.clientY},{passive:true});
document.addEventListener('pointerleave',()=>{ptr.x=ptr.y=-999});

/* ---------- 4 · intro ---------- */
const intro=$('#intro');let introDone=!root.classList.contains('intro-on');
function save2(k){try{sessionStorage.setItem(k,'1')}catch(e){}}
function endIntro(){if(introDone)return;introDone=true;save2('jbr-intro');intro.classList.add('out');root.classList.add('intro-out');lock(0);setTimeout(()=>{root.classList.remove('intro-on');intro.hidden=true},1100);const h=location.hash.slice(1);if(h&&document.getElementById(h))setTimeout(()=>scrollTo({top:topOf(document.getElementById(h)),behavior:'instant'}),60)}
function runIntro(){if(introDone)return;if(RM){introDone=true;save2('jbr-intro');root.classList.remove('intro-on');return}
  lock(1);$('#introList').innerHTML=RECS.map((r,i)=>`<li><b>${pad(i+1)}</b>${esc(r[1])}</li>`).join('');const lis=$$('#introList li'),T0=performance.now(),DUR=2500;
  (function step(){if(introDone)return;const p=Math.min(1,(performance.now()-T0)/DUR);$('#introPct').textContent=String(Math.round(p*100)).padStart(3,'0')+'%';$('#introBar').style.width=p*100+'%';const k=Math.floor(p*lis.length*1.2);lis.forEach((l,i)=>l.classList.toggle('on',i<k));if(p>.4)$('.intro-name').classList.add('on');if(p<1)requestAnimationFrame(step);else setTimeout(endIntro,380)})();
  $('#introSkip').onclick=endIntro;intro.addEventListener('click',endIntro);setTimeout(endIntro,7000)}

/* ---------- 5 · navigation + layered transitions ---------- */
let curI=0,busy=false;const tx=$('#tx'),panels=$$('i',tx);
function setCur(i){curI=i;$('#wn').textContent=pad(i+1);$('#wt').textContent=RECS[i][1];$$('#rail a').forEach((a,j)=>{a.classList.toggle('on',j===i);if(j===i)a.setAttribute('aria-current','true');else a.removeAttribute('aria-current')});$$('.dock a').forEach(a=>a.classList.toggle('on',a.dataset.d===RECS[i][0]));$$('#idxGrid a').forEach((a,j)=>a.parentElement.classList.toggle('here',j===i))}
let tick=false;
function onScroll(){tick=false;const y=scrollY,h=root.scrollHeight-innerHeight;$('#prog').style.transform=`scaleX(${h>0?y/h:0})`;const tp=$('#top');tp.classList.toggle('on',y>700);tp.style.setProperty('--p',(h>0?y/h*100:0)+'%');let c=0;SEC.forEach((e,i)=>{if(topOf(e)-innerHeight*.4<=y)c=i});if(c!==curI)setCur(c)}
addEventListener('scroll',()=>{if(!tick){tick=true;requestAnimationFrame(onScroll)}},{passive:true});
const anim=(el,kf,o)=>el.animate(kf,Object.assign({fill:'forwards',easing:'cubic-bezier(.76,0,.24,1)'},o));
async function transition(id,title,variant,x,y){tx.classList.add('on');const lab=$('#txl');lab.textContent=title;
  const D=520,st=75;let inK,outK;
  if(variant===0){inK=[{transform:'translateX(-101%)'},{transform:'translateX(0)'}];outK=[{transform:'translateX(0)'},{transform:'translateX(101%)'}]}
  else if(variant===1){inK=[{transform:'translateY(101%)'},{transform:'translateY(0)'}];outK=[{transform:'translateY(0)'},{transform:'translateY(-101%)'}]}
  else{const c0=`circle(0px at ${x}px ${y}px)`,c1=`circle(150vmax at ${x}px ${y}px)`;inK=[{transform:'none',clipPath:c0},{transform:'none',clipPath:c1}];outK=[{transform:'none',clipPath:c1},{transform:'none',clipPath:c0}]}
  panels.forEach(p=>{p.getAnimations().forEach(a=>a.cancel());p.style.transform=variant===0?'translateX(-101%)':variant===1?'translateY(101%)':'none';p.style.clipPath=variant===2?'circle(0px at 0 0)':''});
  const ins=panels.map((p,i)=>anim(p,inK,{duration:D,delay:i*st}));
  anim(lab,[{opacity:0,translate:'0 30px'},{opacity:1,translate:'0 0'}],{duration:400,delay:D*.8,easing:'ease-out'});
  await ins[2].finished;beep(300,.25,.05,'sawtooth',500);
  closeAll(true,true);
  scrollTo({top:id==='home'?0:topOf(document.getElementById(id)),behavior:'instant'});setCur(RECS.findIndex(r=>r[0]===id));
  await new Promise(r=>setTimeout(r,260));
  anim(lab,[{opacity:1},{opacity:0}],{duration:220});
  const outs=panels.map((p,i)=>anim(p,outK,{duration:D,delay:i*st}));await outs[2].finished;
  panels.forEach(p=>{p.getAnimations().forEach(a=>a.cancel())});lab.getAnimations().forEach(a=>a.cancel());tx.classList.remove('on')}
async function go(id,o={}){const el=document.getElementById(id);if(!el||busy)return;const y=id==='home'?0:topOf(el),i=RECS.findIndex(r=>r[0]===id);
  if(o.push!==false&&location.hash!=='#'+id)history.pushState(null,'','#'+id);
  const focusIt=()=>{el.setAttribute('tabindex','-1');el.focus({preventScroll:true})};
  if(RM||Math.abs(y-scrollY)<innerHeight*1.1){closeAll(false,true);scrollTo({top:y,behavior:RM?'instant':'smooth'});setTimeout(focusIt,RM?0:600);return}
  busy=true;try{await transition(id,RECS[i][1],i%3,o.x||innerWidth/2,o.y||innerHeight/2)}finally{busy=false;tx.classList.remove('on')}focusIt()}
document.addEventListener('click',e=>{const a=e.target.closest('a[href^="#"]');if(!a||a.getAttribute('href').length<2)return;const id=a.getAttribute('href').slice(1);if(!RECS.some(r=>r[0]===id))return;e.preventDefault();go(id,{x:e.clientX||innerWidth/2,y:e.clientY||innerHeight/2})});
addEventListener('popstate',()=>go(location.hash.slice(1)||'home',{push:false}));
const jump=d=>{const n=Math.max(0,Math.min(RECS.length-1,curI+d));if(n!==curI)go(RECS[n][0])};
$('#rail').innerHTML=RECS.map((r,i)=>`<a href="#${r[0]}" aria-label="${esc(r[1])}"><i></i><span>${esc(r[1])}</span></a>`).join('');
$('#top').onclick=()=>go('home');

/* ---------- 6 · overlays + command center ---------- */
function overlay(el,{ms=720,onOpen,onClose,focus}={}){let t,from;
  return{get open(){return el.classList.contains('open')},
    show(opener){clearTimeout(t);from=opener||document.activeElement;el.hidden=false;void el.offsetWidth;if(!el.classList.contains('open'))lock(1);el.classList.add('open');if(onOpen)onOpen();if(focus)setTimeout(()=>{const f=typeof focus==='function'?focus():$(focus);f&&f.focus&&f.focus()},RM?0:420)},
    hide(instant,nofocus){if(!el.classList.contains('open'))return;if(instant)el.style.transition='none';el.classList.remove('open');lock(0);t=setTimeout(()=>{el.hidden=true;el.style.transition=''},instant?30:ms);if(onClose)onClose();if(!nofocus&&from&&from.focus&&document.contains(from))from.focus()}}}
const idxb=$('#idxb');
const IDX=overlay($('#idx'),{onOpen(){idxb.setAttribute('aria-expanded','true');$('#idxq').value='';filterIdx()},onClose(){idxb.setAttribute('aria-expanded','false')},focus:'#idxq'});
const MAP=overlay($('#map'),{onOpen(){buildMap()},focus:'#mapStage .mn'});
const CMP=overlay($('#cmp'),{focus:'#cmpX'});
function closeAll(instant,nofocus){IDX.hide(instant,nofocus);MAP.hide(instant,nofocus);CMP.hide(instant,nofocus);closePres(instant,nofocus);closeL(instant)}
const copyText=(txt,what,btn)=>{const ok=()=>{toast(what+' copied!');if(btn){btn.classList.add('done');setTimeout(()=>btn.classList.remove('done'),1400)}};
  const fb=()=>{try{const ta=document.createElement('textarea');ta.value=txt;ta.setAttribute('readonly','');ta.style.cssText='position:fixed;left:-999px;top:0';document.body.append(ta);ta.select();const r=document.execCommand('copy');ta.remove();r?ok():toast('Could not copy automatically — please select and copy it manually.')}catch(e){toast('Could not copy automatically — please select and copy it manually.')}};
  if(navigator.clipboard&&window.isSecureContext)navigator.clipboard.writeText(txt).then(ok).catch(fb);else fb()};
const copyEmail=()=>{copyText(EMAIL,'Email',$('#copy'));confetti($('#copy'))};
const dlCV=()=>{const a=document.createElement('a');a.href=CV.u;a.download=CV.dl;document.body.append(a);a.click();a.remove()};
const vcard=()=>{const v='BEGIN:VCARD\nVERSION:3.0\nFN:Jena Benisse Redondo\nN:Redondo;Jena Benisse;;;\nTITLE:BSIT Student\nORG:La Consolacion College Tanauan\nTEL;TYPE=CELL:+639665207724\nEMAIL:'+EMAIL+'\nADR;TYPE=HOME:;;Sulpoc;Tanauan City;Batangas;;Philippines\nURL:https://lcct-24-13096.github.io/portfolio/\nEND:VCARD',a=document.createElement('a');a.href=URL.createObjectURL(new Blob([v],{type:'text/vcard'}));a.download='Jena-Benisse-Redondo.vcf';document.body.append(a);a.click();a.remove();toast('Contact card saved!')};
const ACTS=[['Copy email','fa-solid fa-copy',copyEmail],['Download Curriculum Vitae','fa-solid fa-download',dlCV],['View Curriculum Vitae','fa-solid fa-file-lines',()=>openL([CV],0)],['Open LinkedIn profile','fa-brands fa-linkedin-in',()=>window.open(LI,'_blank','noopener')],['Save my contact (vCard)','fa-solid fa-address-book',vcard],['Play Knowledge Dash','fa-solid fa-gamepad',()=>window.open('https://knowledge-dash.gamer.free/','_blank','noopener')],['Open the discovery map','fa-solid fa-compass',()=>MAP.show($('#mapB'))],['Toggle dark / light mode','fa-solid fa-circle-half-stroke',flip],['Toggle sound effects','fa-solid fa-volume-high',toggleSound],['Send me a message','fa-solid fa-pen',()=>{go('contact');setTimeout(()=>$('#fn').focus({preventScroll:true}),1700)}]];
$('#idxGrid').innerHTML=RECS.map((r,i)=>`<li><a href="#${r[0]}"><span class="n">${pad(i+1)}</span><span><h3>${esc(r[1])}</h3><p>${esc(r[2])}</p></span></a></li>`).join('');
$('#idxAct').innerHTML=ACTS.map((a,i)=>`<button type="button" data-a="${i}"><i class="${a[1]}"></i>${esc(a[0])}</button>`).join('');
const runAct=i=>{const a=ACTS[i];IDX.hide(false,true);setTimeout(a[2],/^(Toggle|Send|Open the)/.test(a[0])?60:360)};
$('#idxAct').onclick=e=>{const b=e.target.closest('button');if(b)runAct(+b.dataset.a)};
$('#swatches').innerHTML=Object.keys(ACC).map(n=>`<button type="button" title="${n}" aria-label="${n} accent" aria-pressed="${n===accN}" data-n="${n}" style="background:rgb(${ACC[n][0]})" class="${n===accN?'on':''}"></button>`).join('');
$('#swatches').onclick=e=>{const b=e.target.closest('button');if(!b)return;accN=b.dataset.n;save('jbr-acc',accN);applyAcc();fieldColor();$$('#swatches button').forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)});toast(accN+' green applied')};
let curOn=load('jbr-cur')!=='off';function setCurT(){document.body.classList.toggle('nocur',!curOn);const b=$('#curT');b.setAttribute('aria-pressed',curOn);b.lastElementChild.textContent=curOn?'on':'off'}$('#curT').onclick=()=>{curOn=!curOn;save('jbr-cur',curOn?'on':'off');setCurT()};setCurT();
idxb.onclick=()=>IDX.open?IDX.hide():IDX.show(idxb);$('#dockIdx').onclick=()=>IDX.show($('#dockIdx'));$('#idxc').onclick=()=>IDX.hide();
$('#mapB').onclick=()=>MAP.show($('#mapB'));$('#wander').onclick=()=>MAP.show($('#wander'));$('#mapX').onclick=()=>MAP.hide();$('#cmpX').onclick=()=>CMP.hide();
/* search index across the whole portfolio (filled once data below exists) */
let ENTRIES=[];
function buildEntries(){ENTRIES=[];
  RECS.forEach((r,i)=>ENTRIES.push({ty:'Section',ic:'fa-hashtag',l:r[1],s:r[2],h:r.join(' '),run:()=>go(r[0])}));
  P.forEach((p,i)=>ENTRIES.push({ty:'Project',ic:'fa-laptop-code',l:p.t,s:p.cat,h:[p.t,p.cat,p.tag,p.d,p.tech.join(' ')].join(' '),run:()=>{go('projects');setTimeout(()=>{pq.value='';ps='';pf='all';$$('#fl button').forEach((x,k)=>x.classList.toggle('on',k===0));showP(i);openPres(i)},RM?60:900)}}));
  C.forEach((c,i)=>ENTRIES.push({ty:'Certificate',ic:'fa-award',l:c[0],s:c[2],h:[c[0],c[1],c[2],c[4],c[5].join(' ')].join(' '),run:()=>{cq.value='';cs2='';cf='All';$$('#ctf button').forEach((x,k)=>x.classList.toggle('on',k===0));cApply();showC(i);openL(cItems(),i,$('#cgPaper'))}}));
  $$('#faq-l details').forEach((d,i)=>ENTRIES.push({ty:'Question',ic:'fa-circle-question',l:$('summary',d).textContent,s:$('.fa p',d).textContent.slice(0,90)+'…',h:d.textContent,run:()=>faqOpen(i)}));
  S.forEach(s=>ENTRIES.push({ty:'Skill',ic:'fa-diagram-project',l:s[0],s:s[1]+' · '+s[3],h:s.join(' '),run:()=>{go('skills');setTimeout(()=>{skF=s[1];skS=s[0];skRender()},RM?60:900)}}));
  ACTS.forEach((a,i)=>ENTRIES.push({ty:'Action',ic:a[1],l:a[0],s:'Quick action',h:a[0],run:a[2]}))}
let resList=[];
function filterIdx(){const q=$('#idxq').value.trim(),body=$('.idx-body'),res=$('#idxRes');body.classList.toggle('searching',!!q);
  if(!q){res.innerHTML='';resList=[];return}
  resList=ENTRIES.filter(e=>matches(e.h+' '+e.l,q)).slice(0,10);
  res.innerHTML=resList.length?resList.map((e,i)=>`<button type="button" data-r="${i}"><i class="fa-solid ${e.ic}"></i><span><b>${esc(e.l)}</b><small>${esc(e.ty)} · ${esc(e.s)}</small></span></button>`).join(''):'<p class="empty">Nothing matches that yet. Try “PHP”, “Cisco”, “internship”, or a project name.</p>'}
$('#idxq').oninput=filterIdx;
$('#idxRes').onclick=e=>{const b=e.target.closest('button');if(!b)return;const r=resList[+b.dataset.r];IDX.hide(false,true);setTimeout(r.run,RM?30:380)};

/* ---------- 7 · hero / about ---------- */
const LK=[['images/profile.jpg','Professional','50% 10%'],['images/casual-1.jpg','Smart casual','50% 20%'],['images/casual-2.jpg','Everyday','50% 28%'],['images/casual-3.jpg','City','50% 25%']];let lk=0,lkT;
