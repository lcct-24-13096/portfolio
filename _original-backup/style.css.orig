/* =========================================================
   JENA BENISSE REDONDO — PORTFOLIO 2.0 · "The Digital Identity Garden"
   tokens → base → chrome → hero → sections → overlays → responsive
   Palette: forest ink · canopy · emerald (signature) · electric fern · mint · sage · olive · paper
   Type: Bricolage Grotesque (display + UI) · Newsreader (reading) · IBM Plex Mono (code only)
   ========================================================= */
:root{
  --f-d:'Bricolage Grotesque','Arial Narrow',system-ui,sans-serif;--f-b:'Newsreader',Georgia,'Times New Roman',serif;--f-m:'IBM Plex Mono',ui-monospace,Menlo,monospace;
  --acc:#34d17f;--acc-rgb:52,209,127;--on-acc:#04170d;--fern:#8ee86a;--olive:#8a9a3f;
  --ease:cubic-bezier(.2,.8,.2,1);--ease-io:cubic-bezier(.76,0,.24,1);
  --gut:clamp(18px,4vw,56px);--bar-h:64px;--r:22px;--r-s:12px;
  --fs-body:1.0625rem;
}
[data-theme=dark]{
  --bg:#08180f;--bg2:#0e2619;--bg3:#143321;--ink:#e8f3e6;--mut:#9db7a2;--line:rgba(190,235,200,.14);--line2:rgba(190,235,200,.3);
  --acc-ink:var(--acc);--glass:rgba(8,24,15,.78);--shadow:0 34px 60px -34px rgba(0,0,0,.8);--band:#0c2216;--paper:#102a1c;--hole:#08180f;--tick:170,225,185;
}
[data-theme=light]{
  --bg:#edf3e8;--bg2:#f9fbf6;--bg3:#d9e6d3;--ink:#10241a;--mut:#3f5a49;--line:rgba(16,36,26,.14);--line2:rgba(16,36,26,.34);
  --acc-ink:#0e6b3c;--glass:rgba(237,243,232,.82);--shadow:0 30px 50px -32px rgba(16,60,35,.4);--band:#dfeadb;--paper:#fbfcf7;--hole:#edf3e8;--tick:20,70,40;
}
.comfy{--fs-body:1.25rem}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:var(--bar-h);-webkit-text-size-adjust:100%}
body{font:400 var(--fs-body)/1.65 var(--f-b);background:var(--bg);color:var(--ink);overflow-x:hidden;transition:background .5s,color .5s;-webkit-font-smoothing:antialiased}
@supports(overflow:clip){html,body{overflow-x:clip}}
img{max-width:100%;display:block;height:auto}ul,ol{list-style:none}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
h1,h2,h3,h4{font-family:var(--f-d);font-weight:700;line-height:1.05;letter-spacing:-.025em;text-wrap:balance}p{text-wrap:pretty}
::selection{background:var(--acc);color:var(--on-acc)}
:focus-visible{outline:3px solid var(--acc);outline-offset:3px;border-radius:4px}
kbd{font:500 .68rem var(--f-m);padding:1px 6px;border:1px solid var(--line2);border-radius:5px;background:color-mix(in srgb,var(--ink) 6%,transparent)}
.wrap{width:min(1240px,calc(100% - 2*var(--gut)));margin-inline:auto;position:relative}
.skip{position:fixed;left:14px;top:-70px;z-index:2000;background:var(--acc);color:var(--on-acc);padding:10px 18px;font:700 .9rem var(--f-d);border-radius:99px;transition:top .2s}.skip:focus{top:14px}
.hide-m{display:inline-flex}
.sub,.sub2,.cat{font:600 .95rem/1.3 var(--f-d);color:var(--acc-ink);letter-spacing:0}.sub2{font-size:clamp(1.6rem,3vw,2.3rem);color:var(--ink);letter-spacing:-.025em;margin-bottom:.4rem}
.cnt,.hint{font:500 .8rem var(--f-m);color:var(--mut)}
/* buttons / chips — pill family (Bricolage) */
.btn{--mx:0px;--my:0px;display:inline-flex;gap:10px;align-items:center;justify-content:center;padding:14px 26px;font:600 .92rem/1 var(--f-d);background:var(--acc);color:var(--on-acc);border:1.5px solid var(--acc);border-radius:99px;transition:background .25s,color .25s,border-color .25s,translate .2s,box-shadow .25s;translate:var(--mx) var(--my);position:relative;white-space:nowrap}
.btn:hover{background:var(--ink);color:var(--bg);border-color:var(--ink);box-shadow:0 10px 24px -12px rgba(var(--acc-rgb),.7)}
.btn:active{scale:.97}
.btn-o{background:transparent;color:var(--ink);border-color:var(--line2)}.btn-o:hover{background:var(--acc);color:var(--on-acc);border-color:var(--acc)}
.btn-s{padding:10px 18px;font-size:.82rem}
.btn[disabled]{opacity:.45;pointer-events:none}
.ib{width:44px;height:44px;display:grid;place-items:center;border:1.5px solid var(--line2);color:var(--ink);transition:.25s;font-size:.95rem;flex:none;border-radius:50%}.ib:hover{background:var(--acc);color:var(--on-acc);border-color:var(--acc);rotate:-8deg}
.chips{display:flex;flex-wrap:wrap;gap:8px}.chips li,.chip-b{padding:7px 15px;border:1.5px solid var(--line2);font:500 .85rem var(--f-d);display:inline-flex;gap:8px;align-items:center;border-radius:99px}.chips i,.chip-b i{color:var(--acc-ink)}
.chip-b{cursor:pointer;color:var(--ink);transition:.25s}.chip-b:hover,.chip-b[aria-pressed=true]{border-color:var(--acc);background:rgba(var(--acc-rgb),.14)}
.tabs{display:flex;gap:8px;flex-wrap:wrap}.tabs button{padding:9px 18px;border:1.5px solid var(--line2);font:600 .86rem var(--f-d);color:var(--mut);transition:.25s;border-radius:99px}.tabs button:hover{color:var(--ink);border-color:var(--ink)}.tabs .on{background:var(--acc);border-color:var(--acc);color:var(--on-acc)}
.cta{display:flex;gap:12px;flex-wrap:wrap}.big{font:400 clamp(1.25rem,2.1vw,1.7rem)/1.5 var(--f-b);color:var(--ink)}.big strong,.cols strong{color:var(--acc-ink);font-weight:600}
.sbox{display:flex;align-items:center;gap:10px;padding:0 16px;border:1.5px solid var(--line2);border-radius:99px;min-height:44px;flex:1 1 220px;max-width:420px;background:color-mix(in srgb,var(--bg2) 60%,transparent);transition:border-color .25s,box-shadow .25s}
.sbox:focus-within{border-color:var(--acc);box-shadow:0 0 0 4px rgba(var(--acc-rgb),.18)}.sbox i{color:var(--acc-ink)}
.sbox input{flex:1;min-width:0;background:none;border:0;outline:0;color:var(--ink);font:500 .92rem var(--f-d);padding:10px 0}.sbox input::placeholder{color:var(--mut)}
.empty{padding:18px 0;color:var(--mut);font-style:italic}
/* reveal system — one calm reveal for blocks, letters rise for titles */
.js .rv{opacity:0;transform:translateY(34px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.js .rv[data-r=left]{transform:translateX(-50px)}.js .rv[data-r=right]{transform:translateX(50px)}
.js .rv[data-r=clip]{opacity:1;transform:none}.js .rv[data-r=clip] img{clip-path:inset(100% 0 0 0);transition:clip-path 1.3s var(--ease-io)}
.js .rv.in{opacity:1;transform:none}.js .rv[data-r=clip].in img{clip-path:inset(0)}
.rt .wd{display:inline-block;overflow:hidden;vertical-align:top;padding:0 .04em .1em;margin-right:.2em}
.js .rt .ch{display:inline-block;transform:translateY(115%);transition:transform .9s var(--ease) calc(var(--i)*26ms)}
.js [data-fx=left] .rt .ch{transform:translateX(-110%)}.js [data-fx=rot] .rt .ch{transform:translateY(115%) rotate(12deg)}
.js .rt.in .ch{transform:none}
/* top bar */
.bar{position:fixed;inset:0 0 auto;height:var(--bar-h);z-index:300;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:0 var(--gut);background:var(--glass);backdrop-filter:blur(14px) saturate(1.3);border-bottom:1px solid var(--line)}
.brand{display:flex;gap:12px;align-items:center}.brand b{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--acc);color:var(--on-acc);font:800 .95rem var(--f-d);letter-spacing:-.04em;transition:rotate .5s var(--ease)}.brand:hover b{rotate:-14deg}.brand span{font:500 .9rem var(--f-d);color:var(--mut)}
.where{font:600 .9rem var(--f-d);display:flex;gap:6px;align-items:baseline;position:absolute;left:50%;translate:-50% 0}.where span{color:var(--acc-ink)}.where i{font-style:normal;color:var(--mut)}.where em{font-style:normal;margin-left:8px}
.bar-r{display:flex;gap:10px;align-items:center}
.btn-idx{gap:12px}.btn-idx kbd{background:none}
.prog{position:absolute;left:0;bottom:-1px;height:3px;width:100%;background:linear-gradient(90deg,var(--olive),var(--acc),var(--fern));transform-origin:0 50%;transform:scaleX(0)}
.rail{position:fixed;left:14px;top:50%;translate:0 -50%;z-index:250;display:flex;flex-direction:column;gap:2px}
.rail a{display:flex;align-items:center;gap:10px;height:26px;padding-right:10px}.rail a i{width:8px;height:8px;border-radius:50%;border:1.5px solid var(--mut);transition:.3s var(--ease);flex:none}
.rail a span{font:600 .78rem var(--f-d);opacity:0;translate:-6px 0;transition:.25s;background:var(--glass);padding:3px 10px;border-radius:99px;white-space:nowrap;pointer-events:none}
.rail a:hover span,.rail a:focus-visible span{opacity:1;translate:0}.rail a.on i{background:var(--acc);border-color:var(--acc);scale:1.7}.rail a:hover i{border-color:var(--acc)}
/* background field: ticks that lean toward the pointer */
#field{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
main,.ft{position:relative;z-index:1}
/* custom cursor */
.cur{position:fixed;inset:0;z-index:2500;pointer-events:none;opacity:0;transition:opacity .3s}.cur.on{opacity:1}
.cur-dot{position:absolute;left:-3px;top:-3px;width:6px;height:6px;border-radius:50%;background:var(--acc)}
.cur-ring{position:absolute;left:-18px;top:-18px;width:36px;height:36px;border:1.5px solid var(--acc);border-radius:50%;display:grid;place-items:center;transition:width .3s var(--ease),height .3s var(--ease),left .3s var(--ease),top .3s var(--ease),background .3s}
.cur.big .cur-ring{width:56px;height:56px;left:-28px;top:-28px;background:rgba(var(--acc-rgb),.16)}
.cur.lab .cur-ring{width:78px;height:78px;left:-39px;top:-39px;background:var(--acc)}.cur-ring em{font:700 .72rem var(--f-d);font-style:normal;color:var(--on-acc);opacity:0;transition:opacity .2s}.cur.lab em{opacity:1}
.nocur .cur{display:none}
@media(hover:hover) and (pointer:fine){body:not(.nocur) .rec,body:not(.nocur) .bar{cursor:none}body:not(.nocur) a,body:not(.nocur) button,body:not(.nocur) summary,body:not(.nocur) .ms-b{cursor:none}body:not(.nocur) input,body:not(.nocur) textarea,body:not(.nocur) select{cursor:text}}
/* layered section transition */
.tx{position:fixed;inset:0;z-index:2400;pointer-events:none;visibility:hidden}.tx.on{visibility:visible}
.tx i{position:absolute;inset:0;transform:translateX(-101%)}.tx i:nth-child(1){background:var(--olive)}.tx i:nth-child(2){background:var(--acc)}.tx i:nth-child(3){background:#0b2a1a}
.tx b{position:absolute;inset:0;display:grid;place-items:center;font:800 clamp(2.4rem,9vw,7rem)/1 var(--f-d);letter-spacing:-.04em;color:var(--fern);opacity:0;z-index:2;text-align:center;padding:0 var(--gut)}
/* intro */
.intro{position:fixed;inset:0;z-index:3000;background:#06140c;color:#e8f3e6;display:none;place-items:center;transition:clip-path 1s var(--ease-io);clip-path:inset(0)}
.intro-on .intro{display:grid}.intro.out{clip-path:inset(0 0 100% 0)}
.intro-in{width:min(980px,calc(100% - 2*var(--gut)));display:grid;gap:clamp(18px,3vh,34px)}
.intro-k{font:500 1.05rem var(--f-d);color:#8ee86a}
.intro-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:6px 18px}.intro-list li{font:600 .95rem var(--f-d);color:#4c6d58;transition:color .35s,translate .5s var(--ease);translate:0 8px;display:flex;gap:8px}.intro-list li b{font:500 .78rem var(--f-m);color:inherit;padding-top:3px}.intro-list li.on{color:#e8f3e6;translate:0}.intro-list li.on b{color:#34d17f}
.intro-name{font:800 clamp(2.6rem,11vw,8rem)/.92 var(--f-d);font-stretch:75%;letter-spacing:-.045em;opacity:0;translate:0 24px;transition:.9s var(--ease);display:flex;flex-direction:column}.intro-name.on{opacity:1;translate:0}.intro-name .o{color:transparent;-webkit-text-stroke:2px #34d17f}
.intro-ft{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.intro-pct{font:500 .9rem var(--f-m);color:#8ee86a}.intro-bar{flex:1;min-width:120px;height:4px;border-radius:9px;background:#143321;overflow:hidden}.intro-bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#8a9a3f,#34d17f,#8ee86a)}
.intro .btn-o{color:#e8f3e6}
/* ---------- sections: shared ---------- */
.rec{padding:clamp(72px,11vw,150px) 0;position:relative;scroll-margin-top:0}
.rh{display:flex;align-items:flex-end;gap:clamp(14px,3vw,40px);margin-bottom:clamp(36px,6vw,80px)}
.rn{font:800 clamp(4.2rem,12vw,10rem)/.8 var(--f-d);font-stretch:75%;color:transparent;-webkit-text-stroke:1.5px var(--acc-ink);letter-spacing:-.05em;flex:none;user-select:none}
.rt{font:800 clamp(2.5rem,6.6vw,6rem)/.95 var(--f-d);font-stretch:80%;letter-spacing:-.04em}
.rsub{margin-top:.9rem;max-width:56ch;color:var(--mut);font-size:1.15rem}
#work .rh,#faq .rh,#presence .rh,#projects .rh{flex-direction:row-reverse;justify-content:flex-end}
#contact .rh{margin-bottom:10px}
.band{background:var(--band);margin-inline:clamp(6px,1.4vw,22px);border-radius:clamp(26px,4.5vw,64px);position:relative;z-index:1}
/* ---------- hero ---------- */
.hero{padding-top:calc(var(--bar-h) + clamp(28px,5vw,64px));padding-bottom:clamp(40px,6vw,80px);min-height:100svh;display:flex;flex-direction:column;justify-content:center}
.hero-g{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:clamp(8px,3vw,40px);align-items:center}
.hero-l{position:relative;z-index:2;min-width:0}
.pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:clamp(14px,2.4vw,26px)}
.pill{display:inline-flex;align-items:center;gap:9px;padding:6px 14px;border-radius:99px;border:1.5px solid var(--line2);font:600 .82rem var(--f-d)}.pill i{width:8px;height:8px;border-radius:50%;background:var(--acc);box-shadow:0 0 0 0 rgba(var(--acc-rgb),.6);animation:ping 2.2s infinite}.pill.ojt{background:var(--acc);border-color:var(--acc);color:var(--on-acc)}.pill.ojt i{background:var(--on-acc);animation:none}
@keyframes ping{70%{box-shadow:0 0 0 10px rgba(var(--acc-rgb),0)}100%{box-shadow:0 0 0 0 rgba(var(--acc-rgb),0)}}
.hi{font:italic 400 clamp(1.2rem,2.2vw,1.7rem) var(--f-b);color:var(--acc-ink);min-height:1.6em}
.nm{font:800 clamp(3.5rem,9.6vw,9rem)/.86 var(--f-d);font-stretch:75%;letter-spacing:-.05em;margin:.04em 0 .1em;display:flex;flex-direction:column}
.nl{display:block;overflow:hidden;padding:.02em .04em .06em;margin-left:-.04em}.nl>span{display:block}
.nl.o>span{color:transparent;-webkit-text-stroke:max(1.5px,.012em) var(--acc-ink)}
.nl:nth-child(1)>span{--k:0}.nl:nth-child(2)>span{--k:1}.nl:nth-child(3)>span{--k:2}
.nl:nth-child(2){padding-left:.5em}
@keyframes rise{from{transform:translateY(108%)}}
.js:not(.intro-on) .nl>span,.js.intro-out .nl>span{animation:rise 1.1s var(--ease) both;animation-delay:calc(var(--k)*110ms + 150ms)}
.js.intro-on:not(.intro-out) .nl>span{transform:translateY(108%)}
.role{font:600 clamp(1.1rem,2vw,1.5rem) var(--f-d);min-height:1.5em;margin-top:6px}.role span:after{content:"";display:inline-block;width:3px;height:1em;background:var(--acc);margin-left:4px;vertical-align:-.12em;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.rl{color:var(--mut);font:500 1rem var(--f-d);margin-top:2px}
.lead{max-width:54ch;margin:clamp(14px,2vw,22px) 0;font-size:clamp(1.1rem,1.5vw,1.28rem);line-height:1.6}
.kw{display:flex;flex-wrap:wrap;gap:8px 20px;margin-bottom:clamp(18px,2.6vw,30px)}.kw li{display:flex;gap:8px;align-items:center;font:600 .92rem var(--f-d)}.kw i{color:var(--acc-ink)}
.wander{display:flex;align-items:center;gap:12px;margin-top:20px;padding:8px 18px 8px 8px;border-radius:99px;border:1.5px dashed var(--line2);font:500 .92rem var(--f-d);color:var(--mut);transition:.3s}.wander i{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--acc);color:var(--on-acc);transition:rotate .8s var(--ease)}.wander b{color:var(--ink)}.wander:hover{border-color:var(--acc);border-style:solid}.wander:hover i{rotate:200deg}
.soc{display:flex;gap:10px;margin-top:20px}
.hero-r{position:relative;--px:0;--py:0;margin-left:-3vw;max-width:520px;justify-self:center;width:100%}
.idc{position:relative;margin:0 auto;width:min(100%,430px)}
.idc-frame{position:relative;aspect-ratio:4/5.2;border-radius:999px 999px 30px 30px;overflow:hidden;background:var(--bg3);border:1.5px solid var(--line2);box-shadow:var(--shadow);isolation:isolate}
.idc-ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;scale:1.08;transition:opacity .9s var(--ease),scale 1.6s var(--ease)}.idc-ph img.on{opacity:1;scale:1}
.cntr{position:absolute;right:16%;bottom:14px;font:500 .78rem var(--f-m);color:#fff;background:rgba(6,20,12,.6);padding:3px 10px;border-radius:99px;z-index:2}
.pbar{position:absolute;left:0;bottom:0;height:4px;width:100%;background:var(--acc);transform-origin:0 50%;transform:scaleX(0);z-index:2}.pbar.go{animation:fill 4.2s linear forwards}@keyframes fill{to{transform:scaleX(1)}}
.idc-tag{position:absolute;left:-8%;bottom:9%;background:var(--paper);border:1.5px solid var(--line2);border-radius:14px;padding:12px 16px;display:grid;gap:1px;box-shadow:var(--shadow);rotate:-3deg;z-index:3}.idc-tag b{font:700 1rem var(--f-d)}.idc-tag span{font-size:.88rem;color:var(--mut);line-height:1.3}
.rbadge{position:absolute;right:-6%;top:6%;width:104px;height:104px;border-radius:50%;background:var(--acc);color:var(--on-acc);display:grid;place-items:center;z-index:3}.rbadge svg{position:absolute;inset:0;animation:spin 18s linear infinite;overflow:visible}.rbadge text{font:700 11.4px var(--f-d);fill:var(--on-acc);letter-spacing:.07em}.rbadge b{font-size:1.2rem;animation:bob 2s ease-in-out infinite}
@keyframes spin{to{rotate:360deg}}@keyframes bob{50%{translate:0 5px}}
.avail{position:absolute;right:-4%;bottom:-24px;display:flex;gap:12px;align-items:center;background:var(--bg2);border:1.5px solid var(--line2);border-radius:99px;padding:10px 20px 10px 14px;box-shadow:var(--shadow);z-index:3}.avail b{display:block;font:700 .86rem var(--f-d);line-height:1.2}.avail small{display:block;font:500 .74rem var(--f-d);color:var(--mut)}
.dotg{width:12px;height:12px;border-radius:50%;background:var(--acc);box-shadow:0 0 0 0 rgba(var(--acc-rgb),.6);animation:ping 2.2s infinite;flex:none}
.looks{display:flex;justify-content:center;gap:10px;margin-top:46px}.looks button{width:48px;height:48px;border-radius:50%;background-size:cover;border:2px solid transparent;outline:1.5px solid var(--line2);outline-offset:3px;opacity:.7;transition:.3s var(--ease)}.looks button:hover{opacity:1;translate:0 -4px}.looks button.on{opacity:1;outline-color:var(--acc);outline-width:2.5px}
.ftag{position:absolute;z-index:3;display:inline-flex;gap:8px;align-items:center;padding:8px 15px;border-radius:99px;background:var(--bg2);border:1.5px solid var(--line2);font:600 .82rem var(--f-d);box-shadow:var(--shadow);translate:calc(var(--px)*var(--k)*1px) calc(var(--py)*var(--k)*1px);transition:translate .4s var(--ease-io)}.ftag i{color:var(--acc-ink)}
.t1{left:-4%;top:12%;--k:14}.t2{right:-9%;top:36%;--k:22}.t3{left:-9%;top:48%;--k:30}.t4{right:-3%;top:72%;--k:38}.t5{left:6%;top:-2%;--k:18}
.ledger{display:grid;grid-template-columns:repeat(4,1fr);margin-top:clamp(44px,7vw,90px);border-top:1.5px solid var(--line2)}
.ledger>div{padding:20px clamp(10px,2vw,28px) 0 0;display:grid;gap:4px;align-content:start}.ledger>div+div{padding-left:clamp(10px,2vw,28px);border-left:1.5px solid var(--line)}
.ledger b{font:800 clamp(2.8rem,6vw,5.2rem)/1 var(--f-d);font-stretch:80%;color:var(--acc-ink);letter-spacing:-.04em}.ledger span{font:700 1.05rem var(--f-d)}.ledger small{color:var(--mut);font-size:.95rem;line-height:1.45;max-width:26ch}
/* marquee */
.mq{overflow:hidden;padding:18px 0;border-block:1.5px solid var(--line);position:relative;z-index:1;background:var(--bg)}.mq>div{display:flex;width:max-content;gap:28px;animation:mq 60s linear infinite}.mq>div.r{animation-direction:reverse;margin-top:6px}
.mq span{display:inline-flex;align-items:center;gap:28px;font:800 clamp(1.8rem,4vw,3.2rem)/1 var(--f-d);font-stretch:78%;letter-spacing:-.03em;white-space:nowrap;color:transparent;-webkit-text-stroke:1.2px var(--ink)}.mq span:nth-child(3n+1){color:var(--ink);-webkit-text-stroke:0}
.mq span:after{content:"";width:.34em;height:.34em;border-radius:50% 0 50% 0;background:var(--acc);rotate:45deg;flex:none}
.mq .r span{-webkit-text-stroke-color:var(--acc-ink)}.mq .r span:nth-child(3n+1){color:var(--acc-ink)}
.mq-big{border:0;padding:clamp(30px,5vw,60px) 0}.mq-big span{font-size:clamp(4rem,13vw,11rem);-webkit-text-stroke-width:2px}
@keyframes mq{to{transform:translateX(-50%)}}
/* ---------- about ---------- */
.about-g{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(28px,6vw,90px);align-items:start}
.about-ph{position:relative;rotate:-2.5deg;margin-top:10px}.about-ph img{width:100%;border-radius:999px 999px 28px 28px;aspect-ratio:4/5;object-fit:cover;object-position:50% 22%;border:1.5px solid var(--line2);box-shadow:var(--shadow);cursor:zoom-in}
.about-ph figcaption{position:absolute;right:-6%;bottom:6%;background:var(--acc);color:var(--on-acc);padding:12px 18px;border-radius:16px;display:grid;rotate:4deg;box-shadow:var(--shadow)}.about-ph figcaption b{font:700 1rem var(--f-d)}.about-ph figcaption span{font-size:.85rem;line-height:1.3}
.about-t{display:grid;gap:22px}
.about-t .big::first-letter{font:800 3.6em/.8 var(--f-d);float:left;margin:.06em .1em 0 0;color:var(--acc-ink)}
.cols{columns:2 280px;column-gap:clamp(22px,3vw,44px);color:var(--ink)}.cols p{break-inside:avoid;margin-bottom:1em}
.more{display:none;align-items:center;gap:10px;font:600 .95rem var(--f-d);color:var(--acc-ink);justify-self:start;padding:8px 0}.more i{transition:rotate .3s}.more[aria-expanded=true] i{rotate:180deg}
.traits{display:flex;flex-wrap:wrap;gap:8px}.traits li{padding:8px 16px 8px 34px;border-radius:99px;background:rgba(var(--acc-rgb),.14);font:600 .9rem var(--f-d);position:relative}.traits li:before{content:"";position:absolute;left:14px;top:50%;width:10px;height:10px;margin-top:-5px;border-radius:50% 0 50% 0;background:var(--acc);rotate:45deg}
.traits li:nth-child(even){rotate:-1.5deg}.traits li:nth-child(3n){rotate:1.2deg}
.about-b{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(20px,4vw,56px);margin-top:clamp(50px,8vw,100px);align-items:center}
.mot{display:grid;gap:12px}.mot li{display:grid;grid-template-columns:auto 1fr;grid-template-areas:"i b" "i s";column-gap:18px;align-items:center;padding:18px 22px;border-radius:var(--r);border:1.5px solid var(--line2);transition:.4s var(--ease);background:color-mix(in srgb,var(--bg2) 55%,transparent)}.mot li:nth-child(2){margin-left:clamp(0px,4vw,56px)}.mot li:nth-child(3){margin-left:clamp(0px,8vw,112px)}
.mot i{grid-area:i;display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:var(--acc);color:var(--on-acc);font-size:1.15rem;transition:rotate .5s var(--ease)}.mot b{grid-area:b;font:700 1.25rem var(--f-d)}.mot span{grid-area:s;color:var(--mut)}
.mot li:hover,.mot li:focus-visible{border-color:var(--acc);translate:8px 0;background:rgba(var(--acc-rgb),.1)}.mot li:hover i{rotate:-18deg}
.file{position:relative;background:var(--paper);border:1.5px solid var(--line2);border-radius:6px 6px 26px 26px;padding:clamp(34px,4vw,48px) clamp(22px,3vw,34px) 28px;rotate:1.6deg;box-shadow:var(--shadow);display:grid;gap:12px;transform-origin:50% 0;transition:rotate .6s var(--ease)}.file:hover{rotate:0deg}
.file:before{content:"";position:absolute;left:34px;bottom:100%;width:2px;height:46px;background:var(--olive)}
.hole{position:absolute;left:25px;top:14px;width:20px;height:20px;border-radius:50%;background:var(--hole);border:2px solid var(--olive)}
.file .ic{display:grid;place-items:center;width:54px;height:54px;border-radius:50%;background:rgba(var(--acc-rgb),.18);color:var(--acc-ink);font-size:1.3rem}.file h3{font-size:1.7rem}.file b{font-weight:600}
.dos{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:clamp(20px,4vw,48px);margin-top:clamp(40px,7vw,90px);align-items:stretch}
.term{background:#071a10;color:#cfe9d5;border-radius:var(--r);overflow:hidden;border:1.5px solid rgba(190,235,200,.2);box-shadow:var(--shadow);display:flex;flex-direction:column}
.term-h{display:flex;align-items:center;gap:7px;padding:12px 16px;border-bottom:1px solid rgba(190,235,200,.14);background:#0b2417}.term-h>i{width:11px;height:11px;border-radius:50%;background:#2f5a40}.term-h>i:first-child{background:#34d17f}.term-h span{margin-left:10px;font:500 .78rem var(--f-m);color:#8fb79b;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tt{display:flex;gap:4px}.tt button{font:500 .75rem var(--f-m);color:#8fb79b;padding:4px 10px;border-radius:99px}.tt .on{background:#34d17f;color:#04170d}
.term pre{padding:20px;font:400 .86rem/1.75 var(--f-m);white-space:pre-wrap;word-break:break-word;min-height:260px;flex:1}.term pre b{color:#34d17f;font-weight:500}.term pre u{text-decoration:none;color:#8ee86a}.term .kk{color:#8ee86a;font-style:normal}.term .ff{color:#c3e88d;font-style:normal}.term .ss{color:#f0d98c;font-style:normal}
.now{border-left:2px solid var(--acc);padding:6px 0 6px clamp(18px,3vw,32px);display:grid;align-content:center;gap:16px}.now ul{display:grid;gap:14px}.now li{display:flex;gap:16px;align-items:flex-start}.now li>i{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:rgba(var(--acc-rgb),.18);color:var(--acc-ink);flex:none}.now span{display:grid;line-height:1.35}.now b{font:700 1rem var(--f-d)}
/* ---------- journey ---------- */
.jt-ctl{display:flex;align-items:center;gap:14px;margin-bottom:10px}.jt-line{flex:1;height:4px;border-radius:9px;background:var(--line);overflow:hidden}.jt-line i{display:block;height:100%;background:linear-gradient(90deg,var(--olive),var(--acc));transform-origin:0 50%;transition:transform .4s var(--ease)}
.jt{display:flex;gap:0;overflow-x:auto;scroll-snap-type:x proximity;padding:16px max(var(--gut),calc((100% - 1240px)/2)) 50px;scroll-padding-inline:max(var(--gut),calc((100% - 1240px)/2));scrollbar-width:thin;scrollbar-color:var(--acc) transparent;cursor:grab}.jt.drag{cursor:grabbing;scroll-snap-type:none}
.ms{flex:0 0 min(360px,82vw);scroll-snap-align:start;position:relative;padding:62px 28px 0 0}
.ms:nth-child(even){padding-top:96px}
.ms:before{content:"";position:absolute;left:0;right:0;top:30px;height:3px;background:repeating-linear-gradient(90deg,var(--line2) 0 10px,transparent 10px 16px)}
.ms:after{content:"";position:absolute;left:0;top:19px;width:25px;height:25px;border-radius:50% 0 50% 50%;rotate:-45deg;background:var(--acc);box-shadow:0 0 0 7px rgba(var(--acc-rgb),.18);transition:scale .4s var(--ease)}
.ms:has([aria-expanded=true]):after{scale:1.3}
.ms-b{text-align:left;display:grid;gap:6px;width:100%;position:relative;padding-right:46px}
.yr{font:800 clamp(3.2rem,6vw,5rem)/.9 var(--f-d);font-stretch:75%;letter-spacing:-.05em;color:var(--acc-ink)}.yr small{font:600 1rem var(--f-d);margin-left:8px;letter-spacing:0;color:var(--mut)}
.when{font:500 .95rem var(--f-d);color:var(--mut)}.ms-b h3{font-size:1.4rem;line-height:1.15}
.plus{position:absolute;right:0;top:6px;width:36px;height:36px;border-radius:50%;border:1.5px solid var(--line2);transition:.3s}.plus:before,.plus:after{content:"";position:absolute;left:50%;top:50%;width:14px;height:2px;margin:-1px 0 0 -7px;background:var(--ink);transition:rotate .35s var(--ease)}.plus:after{rotate:90deg}
.ms-b:hover .plus{background:var(--acc);border-color:var(--acc)}.ms-b:hover .plus:before,.ms-b:hover .plus:after{background:var(--on-acc)}.ms-b[aria-expanded=true] .plus:after{rotate:0deg}
.ms-x{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s var(--ease)}.ms-b[aria-expanded=true]+.ms-x{grid-template-rows:1fr}.ms-x>div{overflow:hidden;min-height:0}
.ms-x>div>*{margin-top:14px}.ms-x ul{list-style:none;display:grid;gap:10px}.ms-x li{padding-left:22px;position:relative}.ms-x li:before{content:"";position:absolute;left:0;top:.7em;width:9px;height:9px;border-radius:50% 0 50% 0;background:var(--acc);rotate:45deg}
.tg{display:flex;flex-wrap:wrap;gap:6px}.tg span{font:600 .8rem var(--f-d);padding:4px 12px;border-radius:99px;background:rgba(var(--acc-rgb),.16);color:var(--ink)}
.cw-s{margin-top:clamp(40px,6vw,80px)}.cw-h{display:flex;justify-content:space-between;gap:20px;align-items:flex-end;flex-wrap:wrap;margin-bottom:28px}
.cw{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:clamp(18px,2.4vw,30px)}
.cw>div{border-top:3px solid var(--acc);padding-top:16px;display:grid;gap:8px;align-content:start;animation:up .6s var(--ease) both;animation-delay:calc(var(--i)*70ms)}.cw>div.now2{border-top-style:dotted}
@keyframes up{from{opacity:0;translate:0 18px}}
.cw .k{color:var(--acc-ink);font-size:1.3rem}.cw h4{font-size:1.2rem;line-height:1.15}.cw ul{display:grid;gap:3px;color:var(--mut)}.cw li:before{content:"— "}.mini{justify-self:start;font:600 .78rem var(--f-d);padding:3px 12px;border-radius:99px;background:var(--acc);color:var(--on-acc)}
/* ---------- what I build ---------- */
.fan{display:flex;gap:12px;min-height:440px}
.fp{flex:1;position:relative;border-radius:var(--r);padding:24px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;gap:10px;transition:flex .65s var(--ease),background .4s;border:1.5px solid var(--line2);background:var(--bg2);cursor:pointer;min-width:0}
.fp:nth-child(1){--fc:#0f3b27}.fp:nth-child(2){--fc:#1a5c3b}.fp:nth-child(3){--fc:#4a5a1e}.fp:nth-child(4){--fc:#cfeedd}
.fp.on{flex:3.4;background:var(--fc);color:#eaf6ec;border-color:transparent}.fp.on:nth-child(4){color:#0b2a1a}
.fp .fn{position:absolute;right:20px;top:6px;font:800 clamp(5rem,12vw,9rem)/1 var(--f-d);font-stretch:75%;color:transparent;-webkit-text-stroke:1.5px currentColor;opacity:.25}
.fp>i{font-size:1.8rem;color:var(--acc-ink)}.fp.on>i{color:var(--fern)}.fp.on:nth-child(4)>i{color:#0e6b3c}
.fp h3{font-size:clamp(1.3rem,2.2vw,2rem)}.fp p{max-width:36ch;opacity:0;max-height:0;overflow:hidden;transition:opacity .4s,max-height .5s var(--ease)}.fp.on p{opacity:1;max-height:200px;transition-delay:.15s}
.fs{font:600 .85rem var(--f-d);opacity:.8}
@media(min-width:900px){.fp:not(.on) h3{writing-mode:vertical-rl;rotate:180deg;align-self:flex-start;margin-top:0;white-space:nowrap}.fp:not(.on) .fs{display:none}}
.proc{margin-top:clamp(56px,8vw,110px);display:grid;gap:26px}
.proc-steps{display:flex;flex-wrap:wrap;gap:10px}.proc-steps button{display:inline-flex;align-items:center;gap:10px;padding:8px 20px 8px 8px;border-radius:99px;border:1.5px solid var(--line2);font:600 .95rem var(--f-d);transition:.3s}.proc-steps b{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--line);font:700 .9rem var(--f-d);transition:.3s}
.proc-steps .on{background:var(--ink);color:var(--bg);border-color:var(--ink)}.proc-steps .on b{background:var(--acc);color:var(--on-acc)}.proc-steps button:hover:not(.on){border-color:var(--acc)}
.proc-d{display:flex;gap:clamp(16px,3vw,34px);align-items:center;padding:clamp(22px,3vw,40px);border-radius:var(--r);background:var(--paper);border:1.5px solid var(--line2);min-height:140px}.proc-d i{font-size:2rem;color:var(--on-acc);background:var(--acc);width:74px;height:74px;display:grid;place-items:center;border-radius:50%;flex:none}.proc-d p{font:400 clamp(1.25rem,2.4vw,1.9rem)/1.4 var(--f-b)}
.ojtw{margin-top:clamp(56px,9vw,120px);background:var(--acc);color:var(--on-acc);border-radius:clamp(26px,4vw,56px);padding:clamp(26px,5vw,64px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:clamp(24px,4vw,56px);position:relative;overflow:hidden}
.ojtw:before{content:"";position:absolute;right:-8%;top:-30%;width:60%;aspect-ratio:1;border-radius:50%;border:2px solid rgba(4,23,13,.18);box-shadow:0 0 0 40px rgba(4,23,13,.05),0 0 0 90px rgba(4,23,13,.04)}
.ojt-l{position:relative}.ojt-t{font:800 clamp(3rem,8vw,7rem)/.9 var(--f-d);font-stretch:75%;letter-spacing:-.05em;margin-bottom:18px}.ojt-t span{color:transparent;-webkit-text-stroke:2px var(--on-acc)}.ojtw .big{color:var(--on-acc);font-size:clamp(1.15rem,1.8vw,1.5rem)}
.ojt-g{display:grid;grid-template-columns:1fr 1fr;gap:12px;position:relative}.ojt-g li{background:rgba(4,23,13,.09);border-radius:18px;padding:18px;display:grid;gap:5px;align-content:start}.ojt-g i{font-size:1.3rem}.ojt-g h4{font-size:1.1rem}.ojt-g p{font-size:.98rem;line-height:1.45}
.ojt-c{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;border-top:2px solid rgba(4,23,13,.2);padding-top:24px;position:relative}.ojt-c h4{font-size:clamp(1.3rem,2.2vw,1.8rem)}.ojt-c p{max-width:46ch}
.ojtw .btn{background:var(--on-acc);color:var(--acc);border-color:var(--on-acc)}.ojtw .btn:hover{background:#fff;color:var(--on-acc);border-color:#fff}.ojtw .btn-o{background:transparent;color:var(--on-acc);border-color:rgba(4,23,13,.5)}.ojtw .btn-o:hover{background:var(--on-acc);color:var(--acc)}
/* ---------- skills ---------- */
.sk-g{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,.6fr);gap:clamp(20px,3vw,40px);align-items:start}
.sk-stage{position:relative;aspect-ratio:1/1;max-height:min(86vh,760px);width:100%;margin-inline:auto;border-radius:50%;border:1.5px solid var(--line2);background:radial-gradient(circle,rgba(var(--acc-rgb),.14) 0 7%,transparent 7.4%),repeating-radial-gradient(circle at 50%,transparent 0 11.6%,var(--line) 11.7% 11.9%)}
#skLines{position:absolute;inset:0;width:100%;height:100%;overflow:visible}#skLines line{stroke:var(--line2);stroke-width:1.5;vector-effect:non-scaling-stroke;transition:.4s}#skLines line.hot{stroke:var(--acc);stroke-width:2.6}#skLines line.dim{opacity:.25}
.nd{position:absolute;translate:-50% -50%;display:grid;justify-items:center;gap:4px;transition:opacity .4s,scale .4s var(--ease);z-index:2}.nd .nd-c{display:grid;place-items:center;width:clamp(36px,5.2vw,58px);aspect-ratio:1;border-radius:50%;background:var(--bg2);border:1.5px solid var(--line2);font-size:clamp(.9rem,1.6vw,1.2rem);color:var(--acc-ink);transition:.3s var(--ease)}
.nd em{position:absolute;top:100%;margin-top:4px;font:600 clamp(.66rem,1.1vw,.82rem) var(--f-d);font-style:normal;white-space:nowrap;background:var(--glass);padding:1px 8px;border-radius:99px}
.nd.cat .nd-c{width:clamp(44px,6.4vw,74px);background:var(--bg3);border-color:var(--acc)}.nd.sk:hover .nd-c,.nd.cat:hover .nd-c{background:var(--acc);color:var(--on-acc);scale:1.12}
.nd.sel .nd-c{background:var(--acc);color:var(--on-acc);box-shadow:0 0 0 7px rgba(var(--acc-rgb),.25);scale:1.15}.nd.dim{opacity:.25}
.nd.core .nd-c{width:clamp(70px,11vw,118px);background:var(--ink);color:var(--bg);border:0;font:800 clamp(1.2rem,2.4vw,1.9rem) var(--f-d);letter-spacing:-.04em;box-shadow:0 0 0 10px rgba(var(--acc-rgb),.18);animation:pulse 3.4s ease-in-out infinite}.nd.core em{position:static;margin:6px 0 0;background:none;color:var(--mut)}
@keyframes pulse{50%{box-shadow:0 0 0 20px rgba(var(--acc-rgb),0)}}
.sk-info{border-left:2px solid var(--acc);padding:4px 0 4px clamp(16px,2.4vw,28px);display:grid;gap:14px;position:sticky;top:calc(var(--bar-h) + 24px)}.sk-info h3{font:800 clamp(2rem,3.6vw,3rem)/1 var(--f-d);font-stretch:80%}.sk-info>p:not(.cat){font-size:1.1rem;min-height:3.2em}.sk-u{font:700 1rem var(--f-d);margin-top:6px}
.note{display:flex;gap:14px;align-items:flex-start;margin-top:clamp(34px,5vw,60px);padding:18px 22px;border-left:4px solid var(--acc);background:rgba(var(--acc-rgb),.1);border-radius:0 var(--r-s) var(--r-s) 0}.note i{color:var(--acc-ink);margin-top:5px}
.grow{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(24px,5vw,80px);margin-top:clamp(50px,8vw,110px)}.grow-l{display:grid;gap:14px;align-content:start}.grow-l h3{font:800 clamp(2rem,4.4vw,3.6rem)/1 var(--f-d);font-stretch:80%}.grow-l p{color:var(--mut)}
.grow-r{display:grid}.grow-r li{display:grid;grid-template-columns:auto 1fr;grid-template-areas:"i h" "i p";column-gap:20px;padding:22px 0;border-top:1.5px solid var(--line2)}.grow-r li:last-child{border-bottom:1.5px solid var(--line2)}.grow-r i{grid-area:i;display:grid;place-items:center;width:46px;height:46px;border-radius:50% 0 50% 50%;background:rgba(var(--acc-rgb),.18);color:var(--acc-ink)}.grow-r h4{grid-area:h;font-size:1.3rem}.grow-r p{grid-area:p;color:var(--mut)}
.gone,[hidden]{display:none!important}
/* ---------- projects ---------- */
.px{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(22px,4vw,56px);align-items:start}
.px-l{display:grid;gap:16px;position:sticky;top:calc(var(--bar-h) + 20px)}
.px-tools{display:flex;gap:10px;flex-wrap:wrap}
.px-list{display:grid;gap:2px;counter-reset:p}.px-list li{border-top:1.5px solid var(--line2);position:relative}.px-list li:last-child{border-bottom:1.5px solid var(--line2)}
.px-list li>button.pick{position:absolute;right:6px;top:50%;translate:0 -50%;width:34px;height:34px;border-radius:50%;border:1.5px solid var(--line2);display:none;place-items:center;font-size:.8rem;background:var(--band);z-index:2}
.px-list.cmp-on li>button.pick{display:grid}.px-list li.picked>button.pick{background:var(--acc);border-color:var(--acc);color:var(--on-acc)}
.px-list li>button:not(.pick){display:grid;grid-template-columns:auto 1fr;grid-template-areas:"n h" "n s";column-gap:16px;align-items:baseline;width:100%;text-align:left;padding:16px 8px;transition:.35s var(--ease)}
.px-list.cmp-on li>button:not(.pick){padding-right:50px}
.px-list .n{grid-area:n;font:500 .85rem var(--f-m);color:var(--mut)}.px-list h3{grid-area:h;font-size:1.2rem;line-height:1.2;transition:.3s}.px-list small{grid-area:s;color:var(--mut);font-size:.95rem}
.px-list li:hover>button:not(.pick){padding-left:18px}.px-list li.on h3{color:var(--acc-ink)}.px-list li.on:before{content:"";position:absolute;left:0;top:-1.5px;height:calc(100% + 1.5px);width:4px;background:var(--acc);border-radius:4px}
.px-list li.hit h3:after{content:" ●";color:var(--acc);font-size:.6em;vertical-align:.2em}
.cmp-bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:12px 14px;border-radius:var(--r-s);background:rgba(var(--acc-rgb),.14)}.cmp-bar span{flex:1;font:600 .9rem var(--f-d);min-width:140px}
.px-stage{position:relative;border-radius:var(--r);overflow:hidden;cursor:pointer;box-shadow:var(--shadow);border:1.5px solid var(--line2);outline-offset:4px}
.v{position:relative;aspect-ratio:16/10;background:linear-gradient(135deg,var(--c1),var(--c2));overflow:hidden;color:#fff;isolation:isolate}
.v .art{position:absolute;inset:0;background:radial-gradient(circle at 80% 15%,rgba(255,255,255,.22),transparent 45%),radial-gradient(circle at 10% 95%,rgba(0,0,0,.35),transparent 55%);z-index:-1}
.v .cap{position:absolute;left:18px;bottom:14px;font:600 .88rem var(--f-d);background:rgba(4,20,11,.62);padding:5px 14px;border-radius:99px;z-index:3;backdrop-filter:blur(6px)}
.v .shots img{position:absolute;border-radius:10px;box-shadow:0 24px 50px -16px rgba(0,0,0,.65);border:1.5px solid rgba(255,255,255,.28);transition:translate .6s var(--ease),scale .6s var(--ease);height:auto}
.v .shots img:nth-child(1){left:5%;top:9%;width:66%;z-index:2}.v .shots img:nth-child(2){right:4%;bottom:11%;width:56%;z-index:3}.v .shots img:nth-child(3){left:12%;bottom:6%;width:42%;z-index:4}
.v:hover .shots img:nth-child(1){translate:-6px -6px}.v:hover .shots img:nth-child(2){translate:6px 6px}
.v .big-i{position:absolute;left:50%;top:44%;translate:-50% -50%;font-size:clamp(4rem,12vw,9rem);opacity:.92;filter:drop-shadow(0 16px 24px rgba(0,0,0,.35))}
.v .big-n{position:absolute;right:20px;top:6px;font:800 clamp(5rem,12vw,10rem)/1 var(--f-d);font-stretch:75%;color:transparent;-webkit-text-stroke:1.5px rgba(255,255,255,.4)}
.v .bar3{position:absolute;left:0;right:0;top:0;height:34px;background:rgba(0,0,0,.28)}.v .bar3:before{content:"";position:absolute;left:14px;top:12px;width:10px;height:10px;border-radius:50%;background:#fff;box-shadow:16px 0 #fff,32px 0 #fff;opacity:.6}
.v .tiles{position:absolute;left:8%;bottom:16%;display:grid;grid-template-columns:repeat(3,26px);gap:7px}.tiles i{aspect-ratio:1;border-radius:6px;background:rgba(255,255,255,.28)}
.v .tk{position:absolute;left:9%;bottom:18%;width:92px;height:54px;border-radius:10px;border:2px dashed rgba(255,255,255,.6)}
.v .rows{position:absolute;left:8%;bottom:14%;display:grid;gap:7px;width:34%}.rows i{height:10px;border-radius:9px;background:rgba(255,255,255,.3)}.rows i:nth-child(odd){width:70%}
.v .cal{position:absolute;left:8%;bottom:14%;display:grid;grid-template-columns:repeat(7,16px);gap:5px}.cal i{aspect-ratio:1;border-radius:4px;background:rgba(255,255,255,.2)}.cal i.f{background:rgba(255,255,255,.7)}
.v .win{position:absolute;left:8%;bottom:14%;display:flex;gap:8px}.win i{width:46px;height:34px;border-radius:7px;border:2px solid rgba(255,255,255,.55)}
.px-nav{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:14px 0}
.px-info{display:grid;gap:14px}.px-info .tag,.tag.lbl{justify-self:start;font:600 .82rem var(--f-d);padding:5px 14px;border-radius:99px;background:var(--acc);color:var(--on-acc)}
.px-info h3{font:800 clamp(1.7rem,3vw,2.5rem)/1.05 var(--f-d);font-stretch:85%}.px-info>p{font-size:1.12rem}
.kst{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:0;border-block:1.5px solid var(--line2)}.kst div{padding:14px 12px;display:grid;font:500 .88rem var(--f-d);color:var(--mut)}.kst div+div{border-left:1.5px solid var(--line)}.kst b{font:800 2rem/1.1 var(--f-d);color:var(--acc-ink);letter-spacing:-.03em}
.tech{display:flex;flex-wrap:wrap;gap:8px}.tech button{padding:6px 15px;border-radius:99px;border:1.5px solid var(--line2);font:600 .85rem var(--f-d);transition:.25s}.tech button:hover{border-color:var(--acc)}.tech button.on{background:var(--acc);color:var(--on-acc);border-color:var(--acc)}
.px-act{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.px-m{font:500 .9rem var(--f-d);color:var(--mut);display:inline-flex;gap:8px;align-items:center}
/* ---------- certificates ---------- */
.c-tools{display:flex;gap:16px;justify-content:space-between;flex-wrap:wrap;align-items:center;margin-bottom:26px}
.cg{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(24px,5vw,70px);align-items:center;perspective:1400px}
.cg-view{position:relative;padding:clamp(14px,3vw,34px);border-radius:var(--r);background:var(--bg3);border:1.5px solid var(--line2)}
.cg-paper{display:block;width:100%;background:#fff;border-radius:6px;box-shadow:0 30px 50px -24px rgba(0,0,0,.6);transition:transform .25s ease-out;transform-style:preserve-3d;will-change:transform;cursor:zoom-in;rotate:-1deg}.cg-paper img{width:100%;border-radius:6px}.cg-paper img.sw{animation:swap .6s var(--ease)}
@keyframes swap{from{opacity:0;clip-path:inset(0 100% 0 0)}to{opacity:1;clip-path:inset(0)}}
.cg-no{position:absolute;left:clamp(14px,3vw,34px);top:-.42em;font:800 clamp(4rem,9vw,7rem)/1 var(--f-d);font-stretch:75%;color:transparent;-webkit-text-stroke:1.5px var(--acc-ink);letter-spacing:-.05em;pointer-events:none}
.cg-nav{position:absolute;right:clamp(14px,3vw,34px);bottom:-22px;display:flex;gap:8px}.cg-nav .ib{background:var(--bg2)}
.cg-meta{display:grid;gap:14px}.cg-meta h3{font:800 clamp(1.8rem,3.4vw,2.8rem)/1.02 var(--f-d);font-stretch:85%}.cg-meta .is{font:600 1rem var(--f-d);color:var(--acc-ink)}.cg-meta .d{font-size:1.1rem}
.strip{display:flex;gap:14px;overflow-x:auto;padding:32px 6px 16px;margin-top:clamp(20px,4vw,40px);scrollbar-width:thin;scrollbar-color:var(--acc) transparent}.strip button{flex:0 0 clamp(150px,19vw,220px);position:relative;border-radius:8px;overflow:hidden;border:2px solid transparent;opacity:.6;transition:.35s var(--ease);background:#fff;rotate:var(--rr,0deg)}
.strip button:nth-child(odd){--rr:-1.4deg}.strip button:nth-child(even){--rr:1.2deg}
.strip button:hover{opacity:1;translate:0 -6px}.strip button[aria-selected=true]{opacity:1;border-color:var(--acc);translate:0 -10px;rotate:0deg;box-shadow:0 16px 30px -14px rgba(var(--acc-rgb),.7)}
.strip b{position:absolute;left:8px;top:8px;font:700 .78rem var(--f-d);background:var(--acc);color:var(--on-acc);padding:1px 9px;border-radius:99px;z-index:2}
/* ---------- CV ---------- */
.cv-g{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(26px,5vw,80px);align-items:center}.cv-l{display:grid;gap:26px}
.toc{display:grid}.toc li{display:flex;gap:18px;padding:14px 0;border-top:1.5px solid var(--line2);font-size:1.12rem}.toc li:last-child{border-bottom:1.5px solid var(--line2)}.toc span{font:500 .85rem var(--f-m);color:var(--acc-ink);padding-top:5px}
.cv-r{display:grid;justify-items:center;gap:14px}.doc{position:relative;width:min(100%,380px);display:block;transition:rotate .6s var(--ease)}.doc:hover{rotate:-2deg}
.doc-sheet{position:absolute;inset:0;background:var(--paper);border:1.5px solid var(--line2);border-radius:8px}.doc-sheet.s2{rotate:4deg;translate:14px 6px}.doc-sheet.s3{rotate:-5deg;translate:-14px 10px;background:var(--acc)}
.doc-main{position:relative;display:block;border-radius:8px;overflow:hidden;box-shadow:var(--shadow);border:1.5px solid var(--line2)}.doc-main img{width:100%;background:#fff}.fold{position:absolute;right:0;top:0;border-style:solid;border-width:0 38px 38px 0;border-color:transparent var(--bg) var(--acc) transparent}
.stamp{position:absolute;right:-26px;bottom:34px;width:104px;height:104px;border-radius:50%;background:var(--acc);color:var(--on-acc);display:grid;place-items:center;text-align:center;font:800 1rem/1.05 var(--f-d);rotate:-12deg;box-shadow:var(--shadow);z-index:3;transition:rotate .6s var(--ease)}.doc:hover .stamp{rotate:12deg}
.doc-cap{font:500 .9rem var(--f-d);color:var(--mut)}
.cv-prev{margin-top:clamp(30px,5vw,56px);display:grid;gap:16px}.cv-prev[hidden]{display:none}.cv-prev-h{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.cv-prev-h .sub2{margin:0}
#cvFrame{width:100%;height:min(86vh,980px);min-height:520px;border:1.5px solid var(--line2);border-radius:var(--r);background:#fff}
/* ---------- presence ---------- */
.li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:clamp(22px,4vw,56px);align-items:center;background:var(--paper);border:1.5px solid var(--line2);border-radius:var(--r);padding:clamp(24px,4vw,56px);box-shadow:var(--shadow);position:relative;rotate:-.8deg;transition:rotate .6s var(--ease)}.li:hover{rotate:0deg}
.li:before{content:"";position:absolute;left:50%;top:-12px;translate:-50% 0;width:70px;height:22px;border-radius:99px;background:var(--bg);border:2px solid var(--olive)}
.li-mark{display:grid;place-items:center;width:clamp(110px,16vw,200px);aspect-ratio:1;border-radius:50% 0 50% 50%;background:var(--acc);color:var(--on-acc);font-size:clamp(3rem,7vw,6rem);transition:border-radius .6s var(--ease)}.li:hover .li-mark{border-radius:50%}
.li-body{display:grid;gap:14px}.li-body h3{font:800 clamp(2rem,4.6vw,4rem)/1 var(--f-d);font-stretch:80%}.li-body>p:not(.cat){max-width:52ch}
.li-url{display:inline-flex;gap:12px;align-items:center;font:600 clamp(.95rem,1.8vw,1.25rem) var(--f-d);color:var(--acc-ink);border-bottom:2px solid currentColor;justify-self:start;max-width:100%;padding-bottom:3px;word-break:break-all}
/* ---------- interests ---------- */
.int-g{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(26px,5vw,76px);align-items:center}
.gl{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(10px,1.6vw,20px);align-items:start}.gl figure{display:grid;gap:8px}.gl figure:nth-child(2){margin-top:clamp(24px,5vw,64px)}.gl figure:nth-child(3){margin-top:clamp(10px,2vw,24px)}
.gl img{width:100%;aspect-ratio:3/5;object-fit:cover;cursor:zoom-in;border:1.5px solid var(--line2);transition:.5s var(--ease)}
.gl figure:nth-child(1) img{border-radius:999px 999px 18px 18px;object-position:50% 10%}.gl figure:nth-child(2) img{border-radius:18px 18px 999px 999px;object-position:50% 28%}.gl figure:nth-child(3) img{border-radius:999px;aspect-ratio:3/5;object-position:50% 25%}
.gl img:hover{scale:1.04;rotate:-1.5deg}.gl figcaption{font:600 .9rem var(--f-d);text-align:center;color:var(--mut)}
.int{display:grid}.int li{display:flex;gap:18px;align-items:center;padding:14px 0;border-top:1.5px solid var(--line2);font:800 clamp(1.7rem,3.8vw,3.2rem)/1.05 var(--f-d);font-stretch:82%;letter-spacing:-.03em;transition:.45s var(--ease)}.int li:last-child{border-bottom:1.5px solid var(--line2)}
.int li i{display:grid;place-items:center;flex:none;width:1.5em;height:1.5em;border-radius:50%;background:rgba(var(--acc-rgb),.18);color:var(--acc-ink);font-size:.55em;transition:.45s var(--ease)}
.int li:hover,.int li:focus-visible,.int li:focus{padding-left:22px;color:var(--acc-ink)}.int li:hover i,.int li:focus i{background:var(--acc);color:var(--on-acc);rotate:-14deg;scale:1.15}
/* ---------- FAQ ---------- */
.faq-t{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:22px;align-items:center}
.faq{display:grid;max-width:980px}.faq details{border-top:1.5px solid var(--line2)}.faq details:last-child{border-bottom:1.5px solid var(--line2)}
.faq summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 0;font:700 clamp(1.25rem,2.6vw,2rem)/1.15 var(--f-d);letter-spacing:-.02em;cursor:pointer;transition:color .3s}.faq summary::-webkit-details-marker{display:none}
.faq summary:after{content:"";flex:none;width:44px;height:44px;border-radius:50%;border:1.5px solid var(--line2);background:linear-gradient(var(--ink),var(--ink)) center/16px 2px no-repeat,linear-gradient(var(--ink),var(--ink)) center/2px 16px no-repeat;transition:rotate .45s var(--ease),background-color .3s,border-color .3s}
.faq summary:hover{color:var(--acc-ink)}.faq summary:hover:after{border-color:var(--acc)}.faq details[open]:not(.closing) summary:after{rotate:135deg;background-color:var(--acc);border-color:var(--acc);background-image:linear-gradient(var(--on-acc),var(--on-acc)),linear-gradient(var(--on-acc),var(--on-acc))}
.fa{overflow:hidden}.fa p{padding:0 64px 24px 0;font-size:1.2rem;max-width:68ch;color:var(--mut)}
/* ---------- contact ---------- */
.ct-h{font:800 clamp(2.6rem,8vw,7.4rem)/.92 var(--f-d);font-stretch:75%;letter-spacing:-.05em;max-width:15ch;margin:10px 0 clamp(34px,6vw,70px)}.ct-h em{font-style:normal;color:transparent;-webkit-text-stroke:max(1.5px,.012em) var(--acc-ink)}
.ct-g{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(26px,5vw,70px);align-items:start}.ct-l{display:grid;gap:22px}
.av{display:flex;gap:12px;align-items:center;font:600 .98rem var(--f-d);color:var(--mut)}.av i{width:11px;height:11px;border-radius:50%;background:var(--acc);animation:ping 2.2s infinite;flex:none}
.links{display:grid;gap:10px}.links li{display:flex;border:1.5px solid var(--line2);border-radius:20px;overflow:hidden;transition:.35s var(--ease);background:color-mix(in srgb,var(--bg2) 55%,transparent)}.links li:hover,.links li:focus-within{border-color:var(--acc);translate:6px 0}
.links li>a,.links li>div{display:flex;gap:16px;align-items:center;padding:14px 18px;flex:1;min-width:0}.links li>a>i,.links li>div>i{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--acc);color:var(--on-acc);flex:none}
.links span{display:grid;font:600 1.02rem var(--f-d);word-break:break-all;line-height:1.3;min-width:0}.links small{font:500 .82rem var(--f-d);color:var(--mut)}
.cp{width:58px;border-left:1.5px solid var(--line2);display:grid;place-items:center;color:var(--ink);transition:.25s;flex:none}.cp:hover{background:var(--acc);color:var(--on-acc)}.cp.done{background:var(--acc);color:var(--on-acc)}
.cf{background:var(--paper);border:1.5px solid var(--line2);border-radius:var(--r);padding:clamp(22px,3.4vw,40px);display:grid;gap:16px;box-shadow:var(--shadow);rotate:.6deg}
.cf h3{font:800 1.8rem var(--f-d)}.cf label{display:grid;gap:6px;font:600 .92rem var(--f-d)}
.cf input,.cf select,.cf textarea{width:100%;font:400 1.05rem var(--f-b);color:var(--ink);background:var(--bg);border:1.5px solid var(--line2);border-radius:14px;padding:13px 16px;outline:0;transition:.25s;resize:vertical}.cf input:focus,.cf select:focus,.cf textarea:focus{border-color:var(--acc);box-shadow:0 0 0 4px rgba(var(--acc-rgb),.2)}.cf .bad{border-color:#e0644b;box-shadow:0 0 0 4px rgba(224,100,75,.18)}
.cf-f{display:flex;gap:16px;align-items:center;flex-wrap:wrap}.cf-f small{color:var(--mut);font-size:.95rem;flex:1;min-width:180px}
/* ---------- footer ---------- */
.ft{background:#071a10;color:#e8f3e6;border-radius:clamp(26px,4.5vw,64px) clamp(26px,4.5vw,64px) 0 0;padding:clamp(48px,7vw,96px) 0 calc(40px + env(safe-area-inset-bottom));margin-top:clamp(20px,4vw,50px)}
.ft-top{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap;align-items:flex-end;padding-bottom:36px;border-bottom:1.5px solid rgba(190,235,200,.2)}.ft-top h3{font:800 clamp(2rem,5vw,4.2rem)/.95 var(--f-d);font-stretch:78%;max-width:16ch;letter-spacing:-.04em}.ft-top p{color:#9db7a2;margin-top:12px}
.ft .btn-o{color:#e8f3e6;border-color:rgba(190,235,200,.4)}.ft .btn:hover{background:#e8f3e6;color:#071a10;border-color:#e8f3e6}.ft .btn-o:hover{background:var(--acc);color:var(--on-acc);border-color:var(--acc)}
.ft-nav{display:flex;flex-wrap:wrap;gap:6px 22px;padding:26px 0}.ft-nav a{font:600 1rem var(--f-d);color:#c4dcc8;border-bottom:1.5px solid transparent;transition:.25s}.ft-nav a:hover{color:var(--acc);border-color:var(--acc)}
.ft-n{font:800 1.4rem var(--f-d)}.ft p{color:#9db7a2}.ft-n b{color:#e8f3e6}.ft-c{margin-top:14px;font-size:.92rem}
/* ---------- overlays ---------- */
.idx,.map,.cmp,.pres{position:fixed;inset:0;z-index:1000;background:var(--bg);overflow:auto;clip-path:inset(0 0 100% 0);transition:clip-path .7s var(--ease-io);overscroll-behavior:contain}
.idx.open,.map.open,.cmp.open{clip-path:inset(0)}
.idx{z-index:1100}
.idx-in{width:min(1100px,calc(100% - 2*var(--gut)));margin:0 auto;min-height:100%;display:flex;flex-direction:column;padding:calc(18px + env(safe-area-inset-top)) 0 calc(18px + env(safe-area-inset-bottom));gap:20px}
.idx-top{display:flex;gap:12px;align-items:center}.idx-s{flex:1;display:flex;gap:14px;align-items:center;border-bottom:2.5px solid var(--acc);padding:6px 4px}.idx-s i{font-size:1.2rem;color:var(--acc-ink)}.idx-s input{flex:1;min-width:0;background:none;border:0;outline:0;color:var(--ink);font:700 clamp(1.1rem,3vw,2rem) var(--f-d);padding:8px 0}.idx-s input::placeholder{color:var(--mut);font-weight:500}
.idx-body{display:grid;gap:26px;flex:1;align-content:start}
.idx-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:8px 22px}
.idx-grid li{border-top:1.5px solid var(--line2)}.idx-grid a{display:flex;gap:16px;align-items:baseline;padding:14px 6px;transition:.3s var(--ease)}.idx-grid a:hover,.idx-grid a:focus-visible{padding-left:16px;background:rgba(var(--acc-rgb),.12)}
.idx-grid .n{font:800 1.5rem var(--f-d);font-stretch:75%;color:var(--acc-ink)}.idx-grid h3{font-size:1.25rem}.idx-grid p{color:var(--mut);font-size:.95rem;line-height:1.35}.idx-grid li.here{border-top-color:var(--acc);border-top-width:3px}
.idx-body.searching .idx-grid,.idx-body.searching .idx-act{display:none}.idx-res{display:grid;gap:4px}.idx-res:empty{display:none}.idx-res h4{font:700 .9rem var(--f-d);color:var(--acc-ink);margin:10px 0 2px}
.idx-res button{display:flex;gap:14px;align-items:center;text-align:left;padding:11px 14px;border-radius:14px;border:1.5px solid transparent;transition:.2s;width:100%}.idx-res button:hover,.idx-res button:focus-visible{background:rgba(var(--acc-rgb),.14);border-color:var(--acc)}
.idx-res button i{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:rgba(var(--acc-rgb),.2);color:var(--acc-ink);flex:none;font-size:.85rem}.idx-res button span{display:grid;line-height:1.3;min-width:0}.idx-res button b{font:700 1rem var(--f-d)}.idx-res button small{color:var(--mut);font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.idx-act{display:flex;flex-wrap:wrap;gap:8px}.idx-act button{display:inline-flex;gap:10px;align-items:center;padding:9px 18px;border-radius:99px;border:1.5px solid var(--line2);font:600 .9rem var(--f-d);transition:.25s}.idx-act button:hover,.idx-act button:focus-visible{background:var(--acc);color:var(--on-acc);border-color:var(--acc)}.idx-act i{color:var(--acc-ink)}.idx-act button:hover i,.idx-act button:focus-visible i{color:var(--on-acc)}
.idx-ft{display:flex;flex-wrap:wrap;gap:12px;align-items:center;padding-top:18px;border-top:1.5px solid var(--line)}.swatches{display:flex;gap:8px;margin-right:6px}.swatches button{width:30px;height:30px;border-radius:50%;border:2px solid var(--bg);outline:1.5px solid var(--line2);transition:.25s}.swatches button:hover{scale:1.15}.swatches .on{outline:2.5px solid var(--ink)}
.keys{flex-basis:100%;font:500 .85rem var(--f-d);color:var(--mut);line-height:2}
/* discovery map */
.map{display:flex;flex-direction:column;padding:calc(16px + env(safe-area-inset-top)) var(--gut) calc(16px + env(safe-area-inset-bottom));gap:12px;background:radial-gradient(circle at 50% 40%,var(--bg3),var(--bg) 70%)}
.map-top{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;flex-wrap:wrap}.map-top h2{font:800 clamp(2rem,5vw,3.6rem)/1 var(--f-d);font-stretch:80%}.map-top p{color:var(--mut);max-width:58ch;margin-top:6px}
.map-stage{position:relative;flex:1;min-height:min(560px,70vh);width:min(1240px,100%);margin-inline:auto}
#mapLines{position:absolute;inset:0;width:100%;height:100%;overflow:visible}#mapLines path{fill:none;stroke:var(--line2);stroke-width:2;stroke-dasharray:3 7;stroke-linecap:round;vector-effect:non-scaling-stroke}#mapLines line{stroke:var(--acc);stroke-width:1.6;vector-effect:non-scaling-stroke;opacity:.7}
.mn{position:absolute;translate:-50% -50%;display:grid;justify-items:center;gap:4px;z-index:2;transition:scale .35s var(--ease),opacity .3s}
.mn .dot{display:grid;place-items:center;width:clamp(44px,6vw,64px);aspect-ratio:1;border-radius:50% 0 50% 50%;rotate:-45deg;background:var(--bg2);border:1.5px solid var(--acc);transition:.35s var(--ease)}.mn .dot b{rotate:45deg;font:800 clamp(.9rem,1.6vw,1.2rem) var(--f-d)}
.mn .t{font:700 clamp(.78rem,1.3vw,.98rem) var(--f-d);background:var(--glass);padding:2px 10px;border-radius:99px;white-space:nowrap}
.mn:hover .dot,.mn:focus-visible .dot,.mn.open .dot{background:var(--acc);color:var(--on-acc);rotate:-45deg;scale:1.12}.mn.here .dot{box-shadow:0 0 0 6px rgba(var(--acc-rgb),.28)}
.mn.sat{scale:0;pointer-events:none;opacity:0}.mn.sat.show{scale:1;pointer-events:auto;opacity:1}.mn.sat .dot{width:clamp(30px,4vw,40px);border-radius:50%;rotate:0;background:var(--band)}.mn.sat .dot i{font-size:.8rem}.mn.sat .t{font-size:.72rem;font-weight:600;max-width:150px;overflow:hidden;text-overflow:ellipsis}
.mn.sat:hover .dot,.mn.sat:focus-visible .dot{rotate:0}
.map-hint{text-align:center;font:600 1rem var(--f-d);color:var(--mut);min-height:1.6em}
/* compare */
.cmp{display:grid;place-items:start center;padding:calc(24px + env(safe-area-inset-top)) var(--gut) 40px}.cmp-in{width:min(1240px,100%);display:grid;gap:22px}.cmp-h{display:flex;justify-content:space-between;align-items:center;gap:14px}.cmp-h h2{font:800 clamp(2rem,5vw,3.6rem)/1 var(--f-d);font-stretch:80%}
.cmp-t{display:grid;grid-template-columns:130px repeat(var(--n,2),minmax(240px,1fr));border:1.5px solid var(--line2);border-radius:var(--r);overflow:auto}.cmp-t>div{padding:14px 18px;border-top:1.5px solid var(--line);font-size:1.02rem;line-height:1.5}.cmp-t>div.fr{border-top:0}
.cmp-t .k{font:700 .88rem var(--f-d);color:var(--acc-ink);background:rgba(var(--acc-rgb),.1)}.cmp-t .hd{font:800 1.3rem/1.1 var(--f-d);background:var(--bg3)}.cmp-t .hd+.hd{border-left:1.5px solid var(--line)}.cmp-t>div:not(.k):not(.corner){border-left:1.5px solid var(--line)}.cmp-t .corner{background:var(--bg3)}
.cmp-t a{color:var(--acc-ink);border-bottom:1.5px solid currentColor;word-break:break-all}
/* presentation */
.pres{clip-path:circle(0 at var(--ox,50%) var(--oy,50%));transition:clip-path .85s var(--ease-io);z-index:1200}.pres.open{clip-path:circle(150vmax at var(--ox,50%) var(--oy,50%))}
.pres-in{width:min(1240px,calc(100% - 2*var(--gut)));margin:0 auto;padding:calc(20px + env(safe-area-inset-top)) 0 60px;display:grid;gap:24px}
.pres-top{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;position:sticky;top:0;z-index:5;background:var(--glass);backdrop-filter:blur(12px);padding:10px 0}.pres-top .lbl{font:600 .95rem var(--f-d);color:var(--acc-ink)}
.pres-v .v{border-radius:var(--r);aspect-ratio:16/9}.pres-v .shots img{cursor:zoom-in}
.pres-d{display:grid;gap:18px;max-width:900px}.pres-d h2{font:800 clamp(2.2rem,6vw,5rem)/.98 var(--f-d);font-stretch:78%;letter-spacing:-.04em}.pres-d>p:not(.px-m){font-size:1.25rem}
/* viewer */
.lb{position:fixed;inset:0;z-index:1500;background:rgba(3,14,8,.88);backdrop-filter:blur(8px);display:grid;place-items:center;opacity:0;transition:opacity .35s}.lb.open{opacity:1}
.lb-x{width:min(1200px,94vw);height:min(92vh,100% - 20px);display:flex;flex-direction:column;background:var(--bg2);border-radius:var(--r);overflow:hidden;border:1.5px solid var(--line2);scale:.96;transition:scale .4s var(--ease)}.lb.open .lb-x{scale:1}
.lb-h{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px;border-bottom:1.5px solid var(--line);flex-wrap:wrap}.lb-h h3{font:700 1.05rem var(--f-d);flex:1;min-width:160px}.lb-b{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.lb-z{display:inline-flex;border:1.5px solid var(--line2);border-radius:99px;overflow:hidden}.lb-z button{padding:8px 14px;font:600 .82rem var(--f-d);min-width:40px;transition:.2s}.lb-z button:hover{background:var(--acc);color:var(--on-acc)}.lb:not(.is-img) .lb-z{display:none}
.lb-stage{flex:1;min-height:0;position:relative;overflow:hidden;background:#06140c;touch-action:none}
#lf{position:absolute;inset:0;width:100%;height:100%;border:0;background:#fff}
#li{position:absolute;left:50%;top:50%;max-width:100%;max-height:100%;width:auto;height:auto;transform:translate(-50%,-50%) translate(var(--tx,0px),var(--ty,0px)) scale(var(--z,1));transform-origin:center;cursor:zoom-in;user-select:none;-webkit-user-drag:none}#li.zoomed{cursor:grab}#li.panning{cursor:grabbing}
.lb-n{position:absolute;top:50%;translate:0 -50%;width:52px;height:52px;border-radius:50%;background:var(--acc);color:var(--on-acc);display:grid;place-items:center;z-index:3;transition:.25s}.lb-n:hover{scale:1.1}.lb-p{left:max(10px,2vw)}.lb-nx{right:max(10px,2vw)}.lb:not(.multi) .lb-n{display:none}
.toast{position:fixed;left:50%;bottom:calc(26px + env(safe-area-inset-bottom));translate:-50% 30px;background:var(--ink);color:var(--bg);padding:12px 22px;border-radius:99px;font:600 .95rem var(--f-d);opacity:0;pointer-events:none;transition:.4s var(--ease);z-index:2600;max-width:calc(100% - 40px);text-align:center}.toast.on{opacity:1;translate:-50% 0}
#bloom{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:2550}
.top{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom));width:50px;height:50px;border-radius:50%;z-index:260;display:grid;place-items:center;background:conic-gradient(var(--acc) var(--p,0%),var(--line2) 0);opacity:0;pointer-events:none;translate:0 20px;transition:.4s var(--ease)}.top:before{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--bg)}.top i{position:relative}.top.on{opacity:1;pointer-events:auto;translate:0}
.dock{display:none}
/* ---------- responsive ---------- */
@media(max-width:1100px){.rail{display:none}.hero-g{grid-template-columns:1fr;gap:56px}.hero-r{margin-left:0;max-width:440px}.nm{font-size:clamp(3.4rem,17vw,9rem)}.sk-g,.px,.grow,.cg,.cv-g,.ct-g,.int-g,.about-g,.about-b,.dos,.ojtw{grid-template-columns:1fr}.px-l,.sk-info{position:static}.about-ph{max-width:420px}.sk-stage{max-height:none}}
@media(max-width:900px){.dock{display:flex;position:fixed;left:50%;bottom:calc(12px + env(safe-area-inset-bottom));translate:-50% 0;z-index:280;background:var(--glass);backdrop-filter:blur(14px);border:1.5px solid var(--line2);border-radius:99px;padding:6px;gap:2px;box-shadow:var(--shadow)}
  .dock a,.dock button{display:grid;justify-items:center;gap:1px;padding:7px 12px;border-radius:99px;font:600 .68rem var(--f-d);color:var(--mut);min-width:58px}.dock a.on{background:var(--acc);color:var(--on-acc)}.dock .dk-i{background:var(--ink);color:var(--bg);width:48px;min-width:48px;height:48px;padding:0;place-items:center;margin:0 4px;font-size:1rem}
  .top{bottom:calc(84px + env(safe-area-inset-bottom))}.ft{padding-bottom:calc(110px + env(safe-area-inset-bottom))}
  .where{display:none}.brand span{display:none}.hide-m{display:none!important}.btn-idx kbd{display:none}
  .fan{flex-direction:column;min-height:0}.fp,.fp.on{flex:none;min-height:96px}.fp.on{min-height:260px}.fp:not(.on) h3{writing-mode:horizontal-tb;rotate:0deg}.fp .fn{font-size:4.5rem}
  .ledger{grid-template-columns:1fr 1fr}.ledger>div:nth-child(3){border-left:0;padding-left:0}.ledger>div:nth-child(n+3){margin-top:22px;border-top:1.5px solid var(--line);padding-top:20px}.ledger>div:nth-child(2n+1){padding-left:0;border-left:0}
  .mot li:nth-child(n){margin-left:0}.ojt-g{grid-template-columns:1fr}.li{grid-template-columns:1fr;rotate:0deg}.rh{flex-wrap:wrap;gap:6px 18px}#work .rh,#faq .rh,#presence .rh,#projects .rh{flex-direction:row}
  .more{display:inline-flex}#bio:not(.open) p:nth-child(n+3){display:none}.fa p{padding-right:0}.faq summary:after{width:38px;height:38px}
  .cf{rotate:0deg}.file{rotate:0deg}.rbadge{width:84px;height:84px;right:-2%}.idc-tag{left:-2%}.avail{right:-2%}.ftag{font-size:.72rem;padding:6px 11px}.t3{left:-3%}.t2{right:-3%}.t5{left:2%}.stamp{right:-8px;width:88px;height:88px;font-size:.88rem}
}
@media(max-width:640px){.nd.sk em{display:none}.nd.sk.sel em{display:block;z-index:5}.nd.cat em{font-size:.62rem}.btn{padding:13px 20px}.cta .btn{flex:1 1 auto}.gl{grid-template-columns:repeat(3,1fr)}.int li{font-size:1.6rem}.cmp-t{grid-template-columns:96px repeat(var(--n,2),minmax(210px,1fr))}.lb-x{width:100vw;height:100%;border-radius:0}.lb-h h3{font-size:.95rem}.idx-act button{font-size:.85rem;padding:8px 14px}.keys{display:none}.v .shots img:nth-child(3){display:none}.rt{font-size:clamp(2.2rem,11vw,3.4rem)}.rn{font-size:clamp(3.4rem,18vw,5rem)}}
/* ---------- reduced motion + calm mode ---------- */
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.mq>div{animation:none!important}.js .rv,.js .rt .ch{opacity:1!important;transform:none!important}}
.calm *,.calm *:before,.calm *:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.calm .mq>div{animation:none!important}.calm .js .rv,.calm.js .rv,.calm.js .rt .ch{opacity:1!important;transform:none!important}.calm .cur{display:none}.calm #field{opacity:.35}
@media print{.bar,.rail,.dock,.top,#field,.cur,.intro{display:none!important}.js .rv,.js .rt .ch{opacity:1!important;transform:none!important}}
